---
import "@/styles/global.css";
import type { Locale } from "@/lib/i18n";
import { isRtl, LOCALE_HREFLANG, getSiteUrl } from "@/lib/i18n";
import { getHreflangs, getCanonical } from "@/lib/seo";
import { getIndexPolicy } from "@/lib/index-policy.mjs";
import { t } from "@/lib/ui";
import { ADDRESS } from "@/data/site";
import SiteHeader from "@/components/SiteHeader.astro";
import StickyCTA from "@/components/StickyCTA.astro";
import JsonLd from "@/components/JsonLd.astro";
import TrackingScript from "@/components/TrackingScript.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  pathSuffix?: string;
  keywords?: string[];
  faq?: { q: string; a: string }[];
  pageType?: "home" | "seo" | "area" | "delivery" | "guide" | "strain" | "contact" | "wholesale" | "locations";
  breadcrumbs?: { name: string; pathSuffix?: string; href?: string }[];
  serviceAreaName?: string;
  article?: {
    headline?: string;
    datePublished?: string;
    dateModified?: string;
    author?: string;
  };
}

const {
  locale,
  title,
  description,
  pathSuffix = "",
  keywords = [],
  faq = [],
  pageType = "seo",
  breadcrumbs = [],
  serviceAreaName,
  article,
} = Astro.props;
const ui = t(locale);
const pageTitle = title ?? ui.meta.title;
const pageDesc = description ?? ui.meta.description;
const canonical = getCanonical(locale, pathSuffix);
const indexPolicy = getIndexPolicy(locale, pathSuffix);
const hreflangs = indexPolicy.indexable
  ? getHreflangs(pathSuffix, indexPolicy.locales as readonly Locale[])
  : [];
const xDefault = indexPolicy.indexable ? getCanonical("en", pathSuffix) : null;
const dir = isRtl(locale) ? "rtl" : "ltr";
const ogLocale = LOCALE_HREFLANG[locale].replace("-", "_");
const siteUrl = getSiteUrl();
---

<!doctype html>
<html lang={LOCALE_HREFLANG[locale]} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="yandex-verification" content="32513d5b96f72918" />
    <meta name="description" content={pageDesc} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="geo.region" content="TH-20" />
    <meta name="geo.placename" content="Pattaya" />
    <meta name="geo.position" content={`${ADDRESS.lat};${ADDRESS.lng}`} />
    <meta name="ICBM" content={`${ADDRESS.lat}, ${ADDRESS.lng}`} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.hreflang} href={h.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <title>{pageTitle}</title>
    <meta
      name="robots"
      content={indexPolicy.indexable ? "index, follow, max-image-preview:large" : "noindex, follow"}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;600;700&family=Noto+Sans+JP:wght@400;600;700&family=Noto+Sans+KR:wght@400;600;700&family=Noto+Sans+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType === "guide" ? "article" : "website"} />
    <meta property="og:site_name" content="Labs Cannabis" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={`${siteUrl}/media/IMG_20260517_175646.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={`${siteUrl}/media/IMG_20260517_175646.jpg`} />
  </head>
  <body>
    <SiteHeader locale={locale} pathSuffix={pathSuffix} />
    <slot />
    <StickyCTA locale={locale} />
    {indexPolicy.indexable && (
      <JsonLd
        locale={locale}
        pathSuffix={pathSuffix}
        title={pageTitle}
        description={pageDesc}
        faq={faq}
        pageType={pageType}
        breadcrumbs={breadcrumbs}
        serviceAreaName={serviceAreaName}
        article={article}
      />
    )}
    <TrackingScript />
  </body>
</html>
