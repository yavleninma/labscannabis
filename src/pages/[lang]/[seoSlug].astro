    guideKeywords: ["パタヤ 大麻 買い方", "パタヤ 大麻 ガイド", "パタヤ 大麻 店"],
    guide: {
      intro:
        "20+ 成人向けの実用ガイドです。移動前に Labs Cannabis のメニュー、効果、鮮度、場所、WhatsApp 連絡を確認できます。",
      sections: [
        {
          h2: "まずメニューを確認",
          body:
            "来店前に、今日新鮮な flower、希望する効果に合う品種、pre-rolls、deals、best sellers の有無を聞いてください。",
        },
        {
          h2: "実際のローカルルートを確認",
          body:
            "Walking Street、Soi Hollywood、Jomtien、Naklua、Pratumnak、Central Pattaya 周辺の near-me 検索では、住所、Google listing、営業時間、来店時間を先に確認してください。",
        },
        {
          h2: "詳細は WhatsApp で",
          body:
            "サイトには public checkout、支払い、予約、order form はありません。個別の availability、delivery possibility、条件は WhatsApp で非公開に相談します。",
        },
      ],
      faq: [
        {
          q: "このサイトで直接購入できますか？",
          a: "できません。サイトはメニューと連絡の入口です。現在の詳細は WhatsApp で確認してください。",
        },
        {
          q: "Labs Cannabis はパタヤのどこですか？",
          a: "Labs Cannabis は Walking Street 近くの Pattaya 13 Alley、別名 Soi Hollywood にあります。",
        },
        {
          q: "このページで配送は確定しますか？",
          a: "いいえ。配送可能性はエリア、時間、必要情報を確認した後に個別で相談します。",
        },
      ],
      closing: "今日のメニュー、効果、鮮度、道順、配送可能性が必要なら来店前に WhatsApp してください。",
    },
  },
};

const special = SPECIAL_COPY[locale] ?? SPECIAL_COPY.en;
const buildCannaThaiContent = (slug: string, h1: string): SeoContent => ({
  h1: special.cannaH1s[slug] ?? h1,
  ...special.canna,
  source: "fallback",
});

const buildBuyingGuideContent = (): SeoContent => ({
  h1: special.guideH1,
  ...special.guide,
  source: "fallback",
});

const content =
  page.brand === "cannathai"
    ? buildCannaThaiContent(slug, page.h1Template[locale])
    : page.intent === "guide"
      ? buildBuyingGuideContent()
      : loadSeoContent(locale, slug);
const title =
  page.brand === "cannathai"
    ? special.cannaTitles[slug] ?? page.titleTemplate[locale]
    : page.intent === "guide"
      ? special.guideTitle
      : page.titleTemplate[locale];
const keywords: string[] =
  page.brand === "cannathai"
    ? special.cannaKeywords
    : page.intent === "guide"
      ? special.guideKeywords
      : page.keywords[locale] ?? page.keywords.en;
const description = seoDescription(content);
const ui = t(locale);
const areaName =
  page.brand === "cannathai" ? "Thailand" : page.area ? getAreaBySlug(page.area)?.name[locale] : undefined;
const pageType =
  page.intent === "delivery"
    ? "delivery"
    : page.intent === "wholesale"
      ? "wholesale"
      : page.intent === "guide"
        ? "guide"
        : "seo";
const parentBreadcrumb =
  page.brand === "cannathai"
    ? { name: special.parent.cannathai, pathSuffix: "wholesale" }
    : page.intent === "guide"
      ? { name: special.parent.guide, pathSuffix: "guides/legal-cannabis-tourists" }
      : { name: ui.locations.title, pathSuffix: "locations" };
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  parentBreadcrumb,
  { name: content.h1 || page.h1Template[locale], pathSuffix: slug },
];
const article =
  page.intent === "guide"
    ? {
        headline: content.h1,
        datePublished: "2026-06-07",
        dateModified: "2026-08-13",
        author: "Labs Cannabis",
      }
    : undefined;
---

<PageLayout
  locale={locale}
  pathSuffix={slug}
  title={title}
  description={description}
  keywords={keywords}
  faq={content.faq}
  pageType={pageType}
  breadcrumbs={breadcrumbs}
  serviceAreaName={areaName}
  article={article}
>
  <article class="px-4 pt-8 pb-4">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{content.h1 || page.h1Template[locale]}</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{content.intro}</p>
      {content.sections.map((sec) => (
        <section class="mt-6">
          <h2 class="text-xl font-bold text-emerald-dim">{sec.h2}</h2>
          <p class="mt-2 text-base leading-relaxed text-text-muted">{sec.body}</p>
        </section>
      ))}
      {content.faq.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-3 text-xl font-bold">{special.faqLabel}</h2>
          {content.faq.map((item) => (
            <details class="card-surface mb-3 p-4">
              <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </section>
      )}
      <p class="mt-6 text-base leading-relaxed text-text-muted">{content.closing}</p>
      <nav class="mt-8 grid gap-3" aria-label={ui.footerSeo.moreTitle}>
        {page.area && page.area !== "pattaya" && (
          <a href={localePath(locale, `areas/${page.area}`)} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
            {getAreaBySlug(page.area)?.name[locale]}
          </a>
        )}
        <a href={localePath(locale, "cannabis-near-me-pattaya")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.nearMe}
        </a>
        <a href={localePath(locale, "delivery/pattaya")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.pattayaDelivery}
        </a>
        <a href={localePath(locale, "how-to-buy-cannabis-pattaya")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.howToBuy}
        </a>
        <a href={localePath(locale, "locations")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.allPages}
        </a>
      </nav>
    </div>
  </article>
  <Reels locale={locale} slides={REELS_SLIDES.slice(0, 3)} mini />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix={slug} />
</PageLayout>
