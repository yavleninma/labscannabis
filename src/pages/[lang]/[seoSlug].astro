---
import PageLayout from "@/layouts/PageLayout.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { SEO_PAGES } from "@/data/seo-matrix";
import { GOOGLE, getMapsDirectionsUrl } from "@/data/site";
import { getIndexPolicy } from "@/lib/index-policy.mjs";
import { loadSeoContent, seoDescription } from "@/lib/content";
import { CTA_LABELS, ctaWhatsAppHref } from "@/data/cta-copy";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; seoSlug: string } }[] = [];
  for (const lang of LOCALES) {
    for (const page of SEO_PAGES) paths.push({ params: { lang, seoSlug: page.slug } });
  }
  return paths;
}

type RetiredCopy = {
  title: string;
  description: string;
  h1: string;
  lead: string;
  body: string;
  maps: string;
  contact: string;
  legal: string;
};

const retiredCopy: Record<Locale, RetiredCopy> = {
  en: {
    title: "Page retired | Labs Cannabis Pattaya",
    description: "This former search page is retired. Use the live Maps listing, contact details, and current official-source legal guide.",
    h1: "This page has been retired",
    lead: "It duplicated another search intent or depended on commercial details that are not maintained here.",
    body: "Use the live Google Maps listing for the current pin and directions. The contact page is for visit coordination only, and the legal guide links to current Thai government sources.",
    maps: "Open Google Maps",
    contact: "Contact and address",
    legal: "Current rules for tourists",
  },
  ru: {
    title: "Страница закрыта | Labs Cannabis Паттайя",
    description: "Эта старая поисковая страница закрыта. Используйте актуальную карточку Maps, контакты и legal guide с официальными источниками.",
    h1: "Эта страница больше не используется",
    lead: "Она дублировала другой интент или зависела от коммерческих данных, которые здесь не поддерживаются.",
    body: "Актуальный пин и маршрут находятся в Google Maps. Контактная страница нужна только для координации визита, а legal guide ведёт на источники правительства Таиланда.",
    maps: "Открыть Google Maps",
    contact: "Контакты и адрес",
    legal: "Актуальные правила для туристов",
  },
  th: {
    title: "ยกเลิกหน้านี้แล้ว | Labs Cannabis พัทยา",
    description: "หน้าค้นหาเดิมนี้ถูกยกเลิก ใช้ Google Maps ข้อมูลติดต่อ และคู่มือกฎที่มีแหล่งข้อมูลทางการล่าสุด",
    h1: "หน้านี้ถูกยกเลิกแล้ว",
    lead: "หน้าเดิมซ้ำกับคำค้นอื่นหรือพึ่งพาข้อมูลเชิงพาณิชย์ที่ไม่ได้ดูแลบนเว็บไซต์นี้",
    body: "ใช้ Google Maps สำหรับหมุดและเส้นทางปัจจุบัน หน้าติดต่อใช้เพื่อประสานการมาเยือนเท่านั้น และคู่มือกฎหมายเชื่อมไปยังแหล่งรัฐบาลไทย",
    maps: "เปิด Google Maps",
    contact: "ติดต่อและที่อยู่",
    legal: "กฎปัจจุบันสำหรับนักท่องเที่ยว",
  },
  ar: {
    title: "تم إيقاف الصفحة | Labs Cannabis باتايا",
    description: "تم إيقاف صفحة البحث السابقة. استخدم بطاقة Maps المباشرة ومعلومات الاتصال والدليل القانوني ذي المصادر الرسمية.",
    h1: "تم إيقاف هذه الصفحة",
    lead: "كانت تكرر نية بحث أخرى أو تعتمد على تفاصيل تجارية لا يتم تحديثها هنا.",
    body: "استخدم Google Maps للدبوس والمسار الحاليين. صفحة الاتصال لتنسيق الزيارة فقط، ويرتبط الدليل القانوني بمصادر الحكومة التايلاندية.",
    maps: "افتح Google Maps",
    contact: "الاتصال والعنوان",
    legal: "القواعد الحالية للسياح",
  },
  zh: {
    title: "页面已停用 | Labs Cannabis 芭提雅",
    description: "此旧搜索页面已停用。请使用实时 Maps 页面、联系方式和链接官方来源的现行法律指南。",
    h1: "此页面已停用",
    lead: "该页面与其他搜索意图重复，或依赖本站不再维护的商业信息。",
    body: "请使用 Google Maps 查看当前定位和路线。联系页面仅用于协调到店；法律指南链接泰国政府来源。",
    maps: "打开 Google Maps",
    contact: "联系方式与地址",
    legal: "游客当前规则",
  },
  ko: {
    title: "사용 중지된 페이지 | Labs Cannabis 파타야",
    description: "이전 검색 페이지는 사용 중지되었습니다. 실시간 Maps 정보, 연락처와 공식 출처가 연결된 법률 가이드를 이용하세요.",
    h1: "이 페이지는 사용 중지되었습니다",
    lead: "다른 검색 의도와 중복되거나 이 사이트에서 관리하지 않는 상업 정보에 의존했습니다.",
    body: "현재 핀과 경로는 Google Maps를 이용하세요. 연락처 페이지는 방문 조율 전용이며 법률 가이드는 태국 정부 자료에 연결됩니다.",
    maps: "Google Maps 열기",
    contact: "연락처 및 주소",
    legal: "관광객을 위한 현재 규정",
  },
  ja: {
    title: "このページは終了しました | Labs Cannabis パタヤ",
    description: "旧検索ページは終了しました。最新の Maps、連絡先、公式情報にリンクする法的ガイドをご利用ください。",
    h1: "このページは終了しました",
    lead: "別の検索意図と重複していたか、このサイトで維持しない商業情報に依存していました。",
    body: "現在のピンと経路は Google Maps を利用してください。連絡先ページは来店調整専用で、法的ガイドはタイ政府情報にリンクしています。",
    maps: "Google Maps を開く",
    contact: "連絡先と住所",
    legal: "旅行者向けの現在のルール",
  },
};

const { lang, seoSlug } = Astro.params;
const locale = lang as Locale;
const slug = seoSlug!;
const page = SEO_PAGES.find((candidate) => candidate.slug === slug)!;
const policy = getIndexPolicy(locale, slug);
const ui = t(locale);
const retired = retiredCopy[locale] ?? retiredCopy.en;
const content = policy.indexable ? loadSeoContent(locale, slug) : null;
const title = content ? page.titleTemplate[locale] : retired.title;
const description = content ? seoDescription(content) : retired.description;
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: policy.indexable ? content!.h1 : retired.h1, pathSuffix: slug },
];
---

<PageLayout
  locale={locale}
  pathSuffix={slug}
  title={title}
  description={description}
  keywords={policy.indexable ? page.keywords[locale] ?? page.keywords.en : []}
  faq={content?.faq ?? []}
  pageType="seo"
  breadcrumbs={breadcrumbs}
>
  {content ? (
    <article class="px-4 pt-8 pb-4">
      <div class="mx-auto max-w-lg">
        <h1 class="text-3xl font-bold leading-tight">{content.h1 || page.h1Template[locale]}</h1>
        <p class="mt-4 text-base leading-relaxed text-text-muted">{content.intro}</p>

        {/*
          Пара кнопок сразу после лида, как в ветке delivery. До этого
          единственным контактным CTA внутри `<article>` был ContactRail в самом
          низу, после FAQ: человек, решивший написать после первого экрана, был
          обязан пролистать всю страницу или целиться в иконку в шапке.
          `data-boilerplate` — блок одинаков на всех SEO-страницах локали и не
          должен попадать в замер уникальности основного контента (W1-02).
        */}
        <div data-boilerplate class="mt-6 grid gap-3 sm:grid-cols-2">
          <a
            href={ctaWhatsAppHref(locale, "menu")}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black"
            data-track="contact_click"
            data-channel="whatsapp"
            data-placement="seo"
          >
            {CTA_LABELS[locale].whatsapp}
          </a>
          <a
            href={getMapsDirectionsUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface flex min-h-12 items-center justify-center px-4 py-3.5 text-center text-base font-semibold text-emerald-dim"
            data-track="contact_click"
            data-channel="directions"
            data-placement="seo"
          >
            {CTA_LABELS[locale].directions}
          </a>
        </div>

        {content.sections.map((section) => (
          <section class="mt-6">
            <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{section.body}</p>
          </section>
        ))}
        {content.faq.length > 0 && (
          <section class="mt-8">
            <h2 class="mb-3 text-xl font-bold">{ui.seo.faqTitle}</h2>
            {content.faq.map((item) => (
              <details class="card-surface mb-3 p-4">
                <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
                <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
              </details>
            ))}
          </section>
        )}
        <p class="mt-6 text-base leading-relaxed text-text-muted">{content.closing}</p>
      </div>
      <ContactRail locale={locale} intent="menu" placement="seo" />
    </article>
  ) : (
    <article class="px-4 py-12">
      <div class="mx-auto max-w-lg">
        <h1 class="text-3xl font-bold leading-tight">{retired.h1}</h1>
        <p class="mt-4 text-lg leading-relaxed text-text-muted">{retired.lead}</p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">{retired.body}</p>
        <nav class="mt-8 grid gap-3" aria-label={retired.h1}>
          <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black" data-track="contact_click" data-channel="maps" data-placement="retired">{retired.maps}</a>
          <a href={localePath(locale, "contact")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{retired.contact}</a>
          <a href={localePath(locale, "guides/legal-cannabis-tourists")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{retired.legal}</a>
        </nav>
      </div>
      <ContactRail locale={locale} intent="visit" placement="seo" />
    </article>
  )}
  <RelatedLinks locale={locale} pathSuffix={slug} placement="seo" />
  {content && <ReviewStrip locale={locale} />}
  {content && <MapBlock locale={locale} />}
  <Footer locale={locale} pathSuffix={slug} />
</PageLayout>
