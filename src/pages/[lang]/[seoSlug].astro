---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import Reels from "@/components/Reels.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { SEO_PAGES, getAreaBySlug } from "@/data/seo-matrix";
import { REELS_SLIDES } from "@/data/media";
import { loadSeoContent, safeSeoTitle, seoDescription } from "@/lib/content";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; seoSlug: string } }[] = [];
  for (const lang of LOCALES) {
    for (const page of SEO_PAGES) {
      paths.push({ params: { lang, seoSlug: page.slug } });
    }
  }
  return paths;
}

const { lang, seoSlug } = Astro.params;
const locale = lang as Locale;
const page = SEO_PAGES.find((p) => p.slug === seoSlug)!;
const content = loadSeoContent(locale, seoSlug);
const title = safeSeoTitle(page.slug, page.titleTemplate[locale]);
const keywords: string[] = [];
const description = seoDescription(content);
const ui = t(locale);
const areaName = page.area ? getAreaBySlug(page.area)?.name[locale] : undefined;
const pageType = page.intent === "delivery" ? "delivery" : page.intent === "wholesale" ? "wholesale" : "seo";
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.locations.title, pathSuffix: "locations" },
  { name: content.h1 || page.h1Template[locale], pathSuffix: seoSlug },
];
---

<PageLayout
  locale={locale}
  pathSuffix={seoSlug}
  title={title}
  description={description}
  keywords={keywords}
  faq={content.faq}
  pageType={pageType}
  breadcrumbs={breadcrumbs}
  serviceAreaName={areaName}
>
  <article class="px-4 pt-8 pb-4">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{content.h1 || page.h1Template[locale]}</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{content.intro}</p>
      {content.sections.map((sec) => (
        <section class="mt-6">
          <h2 class="text-xl font-bold text-emerald-dim">{sec.h2}</h2>
          <p class="mt-2 text-base leading-relaxed text-text-muted">{sec.body}</p>
        </section>
      ))}
      {content.faq.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-3 text-xl font-bold">FAQ</h2>
          {content.faq.map((item) => (
            <details class="card-surface mb-3 p-4">
              <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </section>
      )}
      <p class="mt-6 text-base leading-relaxed text-text-muted">{content.closing}</p>
    </div>
  </article>
  <Reels locale={locale} slides={REELS_SLIDES.slice(0, 3)} mini />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix={seoSlug} />
</PageLayout>
