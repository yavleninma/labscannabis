      "こんにちは、Labs Cannabis。パタヤにいます。店舗までの道順と来店調整をお願いします。",
  },
};

const { lang } = Astro.params;
const locale = (lang ?? "en") as Locale;
const copy = HOME_COPY[locale] ?? HOME_COPY.en;
const addressLine =
  ADDRESS.street + ", " + ADDRESS.locality + ", " + ADDRESS.region + " " + ADDRESS.postalCode;
const identityBridge = BRAND.name + " — listed on Google Maps as " + GOOGLE.listingName;
const mapsHref = getMapsSearchUrl();
const visitHref = CONTACT.whatsappWithMsg(copy.whatsappVisit) + "&source=map";
const enRuIntentLinks = locale === "ru"
  ? {
      nearMe: "Магазин каннабиса рядом в Паттайе",
      walking: "Маршрут от Walking Street",
      delivery: "Актуальные правила доставки каннабиса в Паттайе",
    }
  : {
      nearMe: "Cannabis shop near me in Pattaya",
      walking: "Directions from Walking Street",
      delivery: "Current cannabis delivery rules in Pattaya",
    };
---

<PageLayout
  locale={locale}
  pathSuffix=""
  title={copy.title}
  description={copy.description}
  keywords={[
    "cannabis shop Pattaya",
    "Labs Dispensary Pattaya",
    "Pattaya 13 Alley cannabis",
    "cannabis shop directions Pattaya",
  ]}
  faq={copy.faq}
  pageType="home"
>
  <main>
    <section class="px-4 pb-12 pt-10 sm:pt-16">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">{copy.h1}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">{copy.lead}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={visitHref}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-emerald px-6 py-3.5 text-center font-bold text-black"
            data-track="hero_whatsapp_click"
            data-track-placement="hero"
            data-track-detail="hero:directions"
            data-wa-source="map"
            data-whatsapp-ref="hero_directions"
            data-utm-campaign="directions"
          >
            {copy.primaryCta}
          </a>
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface px-6 py-3.5 text-center font-bold"
            data-track="map_open_click"
            data-track-placement="hero"
            data-track-detail="hero:maps"
          >
            {copy.mapCta}
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label={copy.trustTitle}>
          {copy.proof.map((item) => (
            <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-sm text-text-muted">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-y border-border bg-bg-card/40 px-4 py-12">
      <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
        <article class="card-surface p-6">
          <h2 class="text-2xl font-bold">{copy.identityTitle}</h2>
          <p class="mt-3 leading-relaxed text-text-muted">{copy.identityBody}</p>
          <p class="mt-5 font-bold">{identityBridge}</p>
          <address class="mt-2 not-italic leading-relaxed text-text-muted">{addressLine}</address>
          <a
            class="mt-2 inline-flex font-bold text-text hover:text-emerald-dim"
            href={CONTACT.tel}
            data-track="contact_call_click"
            data-track-placement="home_identity"
            data-track-detail="home_identity:phone"
          >
            {CONTACT.phoneDisplay}
          </a>
        </article>
        <article class="card-surface p-6">
          <h2 class="text-2xl font-bold">{copy.trustTitle}</h2>
          <ul class="mt-4 space-y-3 text-text-muted">
            {copy.trustItems.map((item) => (
              <li class="flex gap-3"><span aria-hidden="true" class="text-emerald">✓</span><span>{item}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section id="areas" class="px-4 py-14">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.areasEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold">{copy.areasTitle}</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-text-muted">{copy.areasLead}</p>
        <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <a
            href={localePath(locale, "labs-dispensary-pattaya")}
            class="card-surface p-4 hover:border-emerald-dim"
            data-track="local_intent_click"
            data-track-placement="home"
            data-track-detail="home:labs-dispensary"
            data-seo-context-link
          >
            <span class="block text-lg font-bold">{identityBridge}</span>
            <span class="mt-2 block text-sm text-emerald-dim">{copy.areaCta} →</span>
          </a>
          {(locale === "en" || locale === "ru") && (
            <>
              <a
                href={localePath(locale, "cannabis-near-me-pattaya")}
                class="card-surface p-4 hover:border-emerald-dim"
                data-track="local_intent_click"
                data-track-placement="home"
                data-track-detail="home:near-me"
                data-seo-context-link
              >
                <span class="block text-lg font-bold">{enRuIntentLinks.nearMe}</span>
                <span class="mt-2 block text-sm text-emerald-dim">{copy.areaCta} →</span>
              </a>
              <a
                href={localePath(locale, "areas/walking-street")}
                class="card-surface p-4 hover:border-emerald-dim"
                data-track="local_intent_click"
                data-track-placement="home"
                data-track-detail="home:walking-street"
                data-seo-context-link
              >
                <span class="block text-lg font-bold">{enRuIntentLinks.walking}</span>
                <span class="mt-2 block text-sm text-emerald-dim">{copy.areaCta} →</span>
              </a>
              <a
                href={localePath(locale, "delivery/pattaya")}
                class="card-surface p-4 hover:border-emerald-dim"
                data-track="local_intent_click"
                data-track-placement="home"
                data-track-detail="home:delivery-rules"
                data-seo-context-link
              >
                <span class="block text-lg font-bold">{enRuIntentLinks.delivery}</span>
                <span class="mt-2 block text-sm text-emerald-dim">{copy.areaCta} →</span>
              </a>
            </>
          )}
        </div>
        <a href={localePath(locale, "locations")} class="mt-6 inline-flex font-bold text-emerald-dim hover:underline">
          {copy.allAreas} →
        </a>
      </div>
    </section>

    <section id="visit" class="border-y border-border bg-bg-card/40 px-4 py-14">
      <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.locationEyebrow}</p>
          <h2 class="mt-2 text-3xl font-bold">{copy.locationTitle}</h2>
          <p class="mt-3 leading-relaxed text-text-muted">{copy.locationBody}</p>
          <div class="mt-5 rounded-xl border border-border bg-bg-card p-5">
            <p class="font-bold">{identityBridge}</p>
            <address class="mt-2 not-italic leading-relaxed text-text-muted">{addressLine}</address>
            <p class="mt-2 text-text-muted">
              {copy.phoneLabel}: <a
                href={CONTACT.tel}
                class="font-bold text-text hover:text-emerald-dim"
                data-track="contact_call_click"
                data-track-placement="home_location"
                data-track-detail="home_location:phone"
              >{CONTACT.phoneDisplay}</a>
            </p>
          </div>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-emerald px-5 py-3 text-center font-bold text-black"
              data-track="map_open_click"
              data-track-placement="location"
              data-track-detail="location:maps"
            >
              {copy.mapCta}
            </a>
            <a
              href={visitHref}
              target="_blank"
              rel="noopener noreferrer"
              class="card-surface px-5 py-3 text-center font-bold"
              data-track="location_whatsapp_click"
              data-track-placement="location"
              data-track-detail="location:directions"
              data-wa-source="map"
              data-whatsapp-ref="visit_coordination"
              data-utm-campaign="directions"
            >
              {copy.primaryCta}
            </a>
          </div>
        </div>
        <iframe
          src={getMapsEmbedUrl()}
          title="Labs Cannabis location on Google Maps"
          class="min-h-[360px] w-full rounded-2xl border border-border"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="px-4 py-14">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold">{copy.faqTitle}</h2>
        <div class="mt-6 space-y-3">
          {copy.faq.map((item) => (
            <details class="card-surface p-5">
              <summary class="cursor-pointer font-bold">{item.q}</summary>
              <p class="mt-3 leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} pathSuffix="" />
</PageLayout>
