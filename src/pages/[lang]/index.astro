        a: "中身は毎日変わるため、このサイトには掲載しません。重量や数字も同様です。WhatsApp でお尋ねいただければ、今日の様子を人がお答えします。ここでは注文も支払いも受け付けません。",
      },
      {
        q: "処方箋は必要ですか？",
        a: "必要です。大麻の花はタイでは管理対象のハーブで、タイで発行された処方箋が求められます。他国で発行されたものは受け付けられません。当サイトの旅行者向け法律ガイドが現行の公式情報へリンクしています。",
      },
      {
        q: "店の場所と、Google マップでの名称は？",
        a: "32 Pattaya 13 Alley、パタヤ南部、チョンブリ 20150。ウェブサイト名は Labs Cannabis で、同じ扉が Google マップでは LABS DISPENSARY と表示されます。一軒の店に二つの名前です。",
      },
      {
        q: "Walking Street からどのくらいですか？",
        a: "Walking Street の北端から歩ける距離です。正確な距離と徒歩時間は座標から計算し、このページ上部に表示しています。ルート案内ボタンは扉までのナビを開きます。",
      },
    ],
  },
};

const { lang } = Astro.params;
const locale = (lang ?? "en") as Locale;
const copy = HOME_COPY[locale] ?? HOME_COPY.en;
const ui = t(locale);
const labels = CTA_LABELS[locale];
const addressLine =
  ADDRESS.street + ", " + ADDRESS.locality + ", " + ADDRESS.region + " " + ADDRESS.postalCode;
const listedAs = renderCopy(copy.listedAs, { brand: BRAND.name, listing: GOOGLE.listingName });
/** Deep link навигации: «как доехать» — это Maps, а «что есть» — это WhatsApp. */
const directionsHref = getMapsDirectionsUrl();
const visitHref = ctaWhatsAppHref(locale, "menu");
/** Цифры карточки Google — визуально и со ссылкой на источник, без разметки рейтинга. */
const ratingLine = formatRatingLine(locale);
/** Вычисленное расстояние вместо обещания «5 минут пешком» из `ui.location.landmark`. */
const landmarkLine = describeLandmarkWalk("walking-street", locale);
/**
 * Языки персонала — единственный пункт блока доверия, который сегодня не
 * рендерится: сайт переведён на семь языков, но это факт о репозитории, а не
 * обещание про человека за прилавком. Пункт появится в тот день, когда владелец
 * назовёт реальный список (O-01), и ни днём раньше.
 */
const staffLanguages = getPublishableStaffLanguages();
const trustItems: TrustItem[] = staffLanguages
  ? [
      ...copy.trustItems,
      {
        title: copy.languagesTitle,
        body: renderCopy(copy.languagesBody, { languages: staffLanguages.join(", ") }),
      },
    ]
  : copy.trustItems;
---

<PageLayout
  locale={locale}
  pathSuffix=""
  title={copy.title}
  description={copy.description}
  keywords={[
    "cannabis dispensary Pattaya",
    "LABS DISPENSARY Pattaya",
    "licensed cannabis shop Pattaya",
    "Pattaya 13 Alley cannabis",
  ]}
  faq={copy.faq}
  pageType="home"
>
  <main>
    <section id="home-hero" class="px-4 pb-12 pt-10 sm:pt-16">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">{copy.h1}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">{copy.lead}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={visitHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center rounded-xl bg-emerald px-6 py-3.5 text-center font-bold text-black"
            data-track="contact_click"
            data-channel="whatsapp"
            data-placement="hero"
          >
            {labels.whatsapp}
          </a>
          <a
            href={directionsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface flex min-h-12 items-center justify-center px-6 py-3.5 text-center font-bold"
            data-track="contact_click"
            data-channel="directions"
            data-placement="hero"
          >
            {labels.directions}
          </a>
        </div>
        {/*
          Доказательства первого экрана: рейтинг ведёт в карточку-источник,
          дистанция вычислена гаверсинусом из координат (W1-03), а часы
          подставит `OpeningStatus` — пока они не подтверждены, чипа просто нет.
        */}
        <ul class="mt-6 flex flex-wrap gap-2 text-sm" aria-label={copy.trustTitle}>
          <li>
            <a
              href={getMapsSearchUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-full border border-border bg-bg-elevated px-3 py-1.5 font-semibold text-emerald-dim hover:border-emerald/40"
              data-track="contact_click"
              data-channel="maps"
              data-placement="hero"
            >
              {ratingLine}
            </a>
          </li>
          {landmarkLine && (
            <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-text-muted">
              {landmarkLine}
            </li>
          )}
          <OpeningStatus
            locale={locale}
            tag="li"
            class="inline-flex rounded-full border border-border bg-bg-card px-3 py-1.5 text-text-muted"
          />
          <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-text-muted">
            {copy.licensedChip}
          </li>
        </ul>
      </div>
    </section>

    <section class="border-y border-border bg-bg-card/40 px-4 py-14">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.shelfEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold">{copy.shelfTitle}</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-text-muted">{copy.shelfBody}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-3">
          {copy.shelfPoints.map((point) => (
            <li class="card-surface p-5 leading-relaxed text-text-muted">
              <span aria-hidden="true" class="mr-2 font-bold text-emerald">→</span>{point}
            </li>
          ))}
        </ul>
        <a
          href={visitHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald px-6 py-3.5 text-center font-bold text-black"
          data-track="contact_click"
          data-channel="whatsapp"
          data-placement="home"
        >
          {labels.whatsapp}
        </a>
      </div>
    </section>

    <ContactRail locale={locale} intent="menu" placement="rail" />

    <section class="px-4 py-14">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-3xl font-bold">{copy.trustTitle}</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {trustItems.map((item) => (
            <article class="card-surface p-6">
              <h3 class="text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-text-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ReviewStrip locale={locale} />

    {/* Анонсы возвращённых в индекс страниц: 8 ссылок — весь набор в один клик. */}
    <RelatedLinks
      locale={locale}
      pathSuffix=""
      placement="home"
      limit={12}
      title={copy.relatedTitle}
      lead={copy.relatedLead}
    />

    <section id="visit" class="border-y border-border bg-bg-card/40 px-4 py-14">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-dim">{copy.locationEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold">{copy.locationTitle}</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-text-muted">{copy.locationBody}</p>
        <div class="mt-5 max-w-xl rounded-xl border border-border bg-bg-card p-5">
          <p class="font-bold">{listedAs}</p>
          <address class="mt-2 not-italic leading-relaxed text-text-muted">{addressLine}</address>
          <p class="mt-2 text-text-muted">
            {copy.phoneLabel}: <a
              href={CONTACT.tel}
              class="font-bold text-text hover:text-emerald-dim"
              data-track="contact_click"
              data-channel="phone"
              data-placement="home"
            >{CONTACT.phoneDisplay}</a>
          </p>
        </div>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a
            href={directionsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center rounded-xl bg-emerald px-5 py-3 text-center font-bold text-black"
            data-track="contact_click"
            data-channel="directions"
            data-placement="map_block"
          >
            {labels.directions}
          </a>
          <a
            href={visitHref}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface flex min-h-12 items-center justify-center px-5 py-3 text-center font-bold"
            data-track="contact_click"
            data-channel="whatsapp"
            data-placement="map_block"
          >
            {labels.whatsappShort}
          </a>
        </div>
      </div>
    </section>

    <MapBlock locale={locale} />

    <section class="px-4 py-14">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold">{copy.faqTitle}</h2>
        <div class="mt-6 space-y-3">
          {copy.faq.map((item) => (
            <details class="card-surface p-5">
              <summary class="cursor-pointer font-bold">{item.q}</summary>
              <p class="mt-3 leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} pathSuffix="" />
</PageLayout>
