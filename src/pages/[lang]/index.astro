---
import PageLayout from "@/layouts/PageLayout.astro";
import Reels from "@/components/Reels.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { REELS_SLIDES } from "@/data/media";
import { HOME_FAQ } from "@/lib/content";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
---

<PageLayout
  locale={locale}
  pathSuffix=""
  title="Labs Cannabis Pattaya | Medical cannabis inquiry"
  description="Ask Labs Cannabis Pattaya about lawful medical cannabis eligibility, Thai documentation, and directions before visiting Soi Hollywood."
  faq={HOME_FAQ}
  pageType="home"
>
  <h1 class="sr-only">Labs Cannabis Pattaya medical cannabis inquiry</h1>
  <Reels locale={locale} slides={REELS_SLIDES} />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} />
</PageLayout>
