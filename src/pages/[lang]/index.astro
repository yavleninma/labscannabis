      { title: "Social", body: "가벼운 저녁용 균형 flower." },
      { title: "Focus", body: "머리가 더 맑은 sativa 방향." },
      { title: "Strong", body: "검증된 데이터가 있는 강한 현재 배치만 문의." },
    ],
    freshnessEyebrow: "신선함 우선",
    freshnessTitle: "실제 flower, 실제 매장, 현재 재고는 채팅으로",
    freshnessBody: "이 사이트는 장바구니가 아니라 storefront입니다. 이동 전 오늘 사진, 신선도, 효과, 재고를 문의하세요.",
    dealsEyebrow: "인기 문의",
    dealsTitle: "공개 checkout 없는 deals",
    dealsLead: "대화 시작점으로 사용하세요. 재고, 배달 세부사항, deal 조건은 WhatsApp에서만 처리합니다.",
    dealCta: "현재 deal 문의",
    trustEyebrow: "신뢰 신호",
    trustTitle: "익명 메뉴가 아닌 파타야 실제 매장",
    trustItems: ["방문 전 Google listing과 지도 확인", "콘텐츠 전 20+ age gate", "공개 checkout, 결제, order form 없음", "메뉴, 문서, 배송 세부사항은 비공개 확인"],
    deliveryEyebrow: "배달 가능성",
    deliveryTitle: "파타야에서는 채팅 후 배달이 가능할 수 있습니다",
    deliveryBody: "Jomtien, Walking Street, Naklua, Pratumnak, Central Pattaya, Soi Hollywood 등 지역을 먼저 보내주세요. WhatsApp에서 가능 여부를 확인합니다.",
    deliveryCta: "배달 가능성 확인",
    locationEyebrow: "위치",
    locationTitle: "Walking Street 근처 Soi Hollywood",
    locationBody: "최신 정보와 길찾기는 Maps를 사용하세요. 방문 전 오늘 메뉴와 신선도 메모가 필요하면 메시지 주세요.",
    openMaps: "지도 열기",
    faqTitle: "자주 묻는 질문",
    faq: [
      { q: "웹사이트에서 주문이나 결제가 가능한가요?", a: "아니요. 공개 checkout, 결제, 예약, order form은 없습니다. 세부사항은 WhatsApp에서 문의하세요." },
      { q: "오늘 메뉴를 볼 수 있나요?", a: "네. 현재 품종, 효과, 신선도, 재고는 WhatsApp으로 문의하세요." },
      { q: "배달은 보장되나요?", a: "아니요. 배달은 지역과 세부사항 확인 후 비공개로 논의하는 가능성입니다." },
    ],
    whatsapp: {
      menu: "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today’s fresh menu, effects, location, and pickup/delivery options.",
      effect: "Hi Labs Cannabis, I am 20+ and in Pattaya. Please help me choose by effect: relax / social / focus / strong.",
      deal: "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send the current flower and pre-roll deals.",
      delivery: "Hi Labs Cannabis, I am 20+ and in Pattaya. Can you check delivery possibility for my area?",
      location: "Hi Labs Cannabis, I am 20+ and near Soi Hollywood. Please send today’s menu and location details.",
      strainPrefix: "Hi Labs Cannabis, I am 20+ and in Pattaya. Please tell me today’s availability for",
    },
  },
} satisfies Record<Locale, HomeCopy>;

const { lang } = Astro.params;
const locale = lang as Locale;
const copy = HOME_COPY[locale] ?? HOME_COPY.en;
const local = HOME_LOCAL[locale] ?? HOME_LOCAL.en;
const faq = [...copy.faq, ...local.faq];
const numberLocale = LOCALE_HREFLANG[locale];
const baht = (value: number) => new Intl.NumberFormat(numberLocale).format(value);
const waHref = (message: string) => CONTACT.whatsappWithMsg(message);
const strainHref = (strain: Strain) => waHref(`${copy.whatsapp.strainPrefix} ${strain.name}.`);
const featuredDeals = PRICE_LADDER.filter((tier) => ["1g", "10g", "30g"].includes(tier.weight));
const heroStyle = `background-image: linear-gradient(90deg, rgba(4, 9, 5, 0.84), rgba(4, 9, 5, 0.48)), url('${HOME_MEDIA.hero.src}')`;
---

<PageLayout
  locale={locale}
  pathSuffix=""
  title={copy.title}
  description={copy.description}
  keywords={["cannabis Pattaya", "weed shop Pattaya", "cannabis menu Pattaya", "Pattaya delivery", "Soi Hollywood cannabis"]}
  faq={faq}
  pageType="home"
>
  <main>
    <section id="home-hero" class="relative overflow-hidden bg-text bg-cover bg-center text-white" style={heroStyle}>
      <div class="absolute inset-0 bg-[center_35%] bg-cover opacity-0"></div>
      <div class="mx-auto grid min-h-[calc(100svh-4.5rem)] max-w-6xl content-end gap-8 px-4 py-10 md:min-h-[680px] md:grid-cols-[1.04fr_0.96fr] md:items-end md:py-16">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald">{copy.eyebrow}</p>
          <h1 class="mt-4 max-w-4xl text-5xl font-black leading-[0.98] text-white md:text-7xl">
            {copy.h1}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/86 md:text-xl">{copy.lead}</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a
              href={waHref(copy.whatsapp.menu)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-emerald px-5 py-3.5 text-base font-black text-black shadow-lg shadow-black/20"
              data-track="contact_whatsapp_click"
              data-whatsapp-source="hero"
              data-whatsapp-ref="hero_menu"
              data-utm-campaign="hero"
            >
              {copy.primaryCta}
            </a>
            <a
              href={getMapsSearchUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg border border-white/45 bg-white/14 px-5 py-3.5 text-base font-bold text-white backdrop-blur-md"
              data-track="map_open_click"
              data-whatsapp-source="map"
              data-track-placement="hero"
              data-track-detail="hero:maps"
            >
              {copy.mapCta}
            </a>
          </div>
        </div>
        <div class="grid gap-3 rounded-lg border border-white/18 bg-black/34 p-4 backdrop-blur-md md:mb-1">
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-2">
            {copy.proof.map((item) => (
              <div class="rounded-lg border border-white/14 bg-white/10 px-3 py-2 text-sm font-bold text-white">{item}</div>
            ))}
          </div>
          <div class="rounded-lg bg-white px-4 py-3 text-text">
            <p class="text-sm font-bold text-emerald-dim">{GOOGLE.rating} Google rating · {GOOGLE.reviewCount} reviews</p>
            <p class="mt-1 text-sm leading-relaxed text-text-muted">
              {ADDRESS.street}, {ADDRESS.locality}. {HOURS.open}-{HOURS.close}.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="menu" class="bg-bg py-14 md:py-18">
      <div class="mx-auto max-w-6xl px-4">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.menuEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.menuTitle}</h2>
          <p class="mt-4 text-base leading-relaxed text-text-muted md:text-lg">{copy.menuLead}</p>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {ALL_STRAINS.map((strain) => {
            const profile = copy.strainProfiles[strain.slug] ?? copy.strainProfiles["white-widow"];
            return (
              <article class="rounded-lg border border-border bg-bg-card p-5 shadow-sm shadow-black/5">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-sm font-bold text-emerald-dim">{copy.typeLabels[strain.type]}</p>
                    <h3 class="mt-1 text-2xl font-black text-text">{strain.name}</h3>
                  </div>
                  <p class="rounded-lg bg-bg-elevated px-3 py-2 text-sm font-bold text-text">
                    {copy.potency}: {strain.thcPercent ? `${strain.thcPercent}%` : copy.confirmBatch}
                  </p>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                  {profile.effects.map((effect) => (
                    <span class="rounded-full bg-emerald/10 px-3 py-1 text-sm font-bold text-emerald-dim">{effect}</span>
                  ))}
                </div>
                <p class="mt-4 text-base font-bold text-text">{profile.mood}</p>
                <p class="mt-2 text-base leading-relaxed text-text-muted">{profile.useCase}</p>
                <a
                  href={strainHref(strain)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-text px-4 py-3 text-base font-bold text-white"
                  data-track="contact_whatsapp_click"
                  data-whatsapp-source="product_card"
                  data-whatsapp-ref={strain.slug}
                  data-utm-campaign="product_card"
                  data-utm-content={strain.slug}
                >
                  {copy.askStrain}
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="bg-text py-14 text-white md:py-18">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald">{copy.effectsEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.effectsTitle}</h2>
          <p class="mt-4 text-base leading-relaxed text-white/78 md:text-lg">{copy.effectsLead}</p>
          <a
            href={waHref(copy.whatsapp.effect)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-emerald px-5 py-3.5 text-base font-black text-black sm:w-auto"
            data-track="contact_whatsapp_click"
            data-whatsapp-source="hero"
            data-whatsapp-ref="effect_picker"
            data-utm-campaign="effect_picker"
          >
            {copy.effectsCta}
          </a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {copy.effectCards.map((item) => (
            <article class="rounded-lg border border-white/16 bg-white/8 p-5">
              <h3 class="text-2xl font-black">{item.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-white/78">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="fresh" class="bg-bg py-14 md:py-18">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-lg border border-border bg-bg-card">
          <img src={HOME_MEDIA.freshness.src} alt={HOME_MEDIA.freshness.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.freshnessEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.freshnessTitle}</h2>
          <p class="mt-4 text-base leading-relaxed text-text-muted md:text-lg">{copy.freshnessBody}</p>
        </div>
      </div>
    </section>

    <section class="bg-bg-elevated py-14 md:py-18">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.dealsEyebrow}</p>
        <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.dealsTitle}</h2>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg">{copy.dealsLead}</p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {featuredDeals.map((tier) => (
            <article class="rounded-lg border border-border bg-bg-card p-5 shadow-sm shadow-black/5">
              <p class="text-sm font-bold text-emerald-dim">{tier.weight}</p>
              <h3 class="mt-1 text-3xl font-black text-text">{baht(tier.total)}฿</h3>
              <p class="mt-1 text-base text-text-muted">{baht(tier.perGram)}฿/g</p>
              <a
                href={waHref(`${copy.whatsapp.deal} ${tier.weight}.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-emerald px-4 py-3 text-base font-black text-black"
                data-track="contact_whatsapp_click"
                data-whatsapp-source="product_card"
                data-whatsapp-ref={`deal_${tier.weight}`}
                data-utm-campaign="deals"
                data-utm-content={tier.weight}
              >
                {copy.dealCta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-bg py-14 md:py-18">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.trustEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.trustTitle}</h2>
          <div class="mt-6 grid gap-3">
            {copy.trustItems.map((item) => (
              <p class="rounded-lg border border-border bg-bg-card px-4 py-3 text-base font-bold text-text">{item}</p>
            ))}
          </div>
        </div>
        <div class="rounded-lg border border-border bg-bg-card p-5 shadow-sm shadow-black/5">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.deliveryEyebrow}</p>
          <h3 class="mt-2 text-3xl font-black leading-tight text-text">{copy.deliveryTitle}</h3>
          <p class="mt-3 text-base leading-relaxed text-text-muted">{copy.deliveryBody}</p>
          <a
            href={waHref(copy.whatsapp.delivery)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-text px-4 py-3 text-base font-bold text-white"
            data-track="contact_whatsapp_click"
            data-whatsapp-source="delivery"
            data-whatsapp-ref="home_delivery"
            data-utm-campaign="delivery"
          >
            {copy.deliveryCta}
          </a>
        </div>
      </div>
    </section>

    <section id="areas" class="bg-bg-elevated py-14 md:py-18">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{local.eyebrow}</p>
        <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{local.title}</h2>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg">{local.lead}</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {AREAS.map((area) => (
            <article class="rounded-lg border border-border bg-bg-card p-4">
              <h3 class="text-lg font-black text-text">{area.name[locale]}</h3>
              <div class="mt-3 flex flex-col gap-2">
                <a href={localePath(locale, `areas/${area.slug}`)} class="text-sm font-bold text-emerald-dim hover:underline">
                  {renderCopy(local.shop, { area: area.name[locale] })}
                </a>
                <a href={localePath(locale, `delivery/${area.slug}`)} class="text-sm font-bold text-text-muted hover:text-emerald-dim">
                  {renderCopy(local.delivery, { area: area.name[locale] })}
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={localePath(locale, "cannabis-near-me-pattaya")} class="rounded-lg border border-border bg-bg-card px-4 py-2 text-sm font-bold hover:text-emerald-dim">{local.nearMe}</a>
          <a href={localePath(locale, "how-to-buy-cannabis-pattaya")} class="rounded-lg border border-border bg-bg-card px-4 py-2 text-sm font-bold hover:text-emerald-dim">{local.howToBuy}</a>
          <a href={localePath(locale, "guides/legal-cannabis-tourists")} class="rounded-lg border border-border bg-bg-card px-4 py-2 text-sm font-bold hover:text-emerald-dim">{local.legal}</a>
          <a href={localePath(locale, "locations")} class="rounded-lg border border-border bg-bg-card px-4 py-2 text-sm font-bold hover:text-emerald-dim">{local.more}</a>
        </div>
      </div>
    </section>

    <section id="visit" class="bg-text py-14 text-white md:py-18">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald">{copy.locationEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.locationTitle}</h2>
          <p class="mt-4 text-base leading-relaxed text-white/78 md:text-lg">{copy.locationBody}</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={waHref(copy.whatsapp.location)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-emerald px-5 py-3.5 text-base font-black text-black"
              data-track="contact_whatsapp_click"
              data-whatsapp-source="map"
              data-whatsapp-ref="location_whatsapp"
              data-utm-campaign="location"
            >
              {copy.primaryCta}
            </a>
            <a
              href={getMapsSearchUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg border border-white/35 bg-white/10 px-5 py-3.5 text-base font-bold text-white"
              data-track="map_open_click"
              data-track-placement="location"
              data-track-detail="location:maps"
            >
              {copy.openMaps}
            </a>
          </div>
        </div>
        <div class="overflow-hidden rounded-lg border border-white/16 bg-white/8">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(GOOGLE.placeQuery)}&output=embed`}
            width="100%"
            height="360"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Labs Cannabis Pattaya map"
          />
        </div>
      </div>
    </section>

    <section class="bg-bg py-14 md:py-18">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="text-3xl font-black leading-tight md:text-5xl">{copy.faqTitle}</h2>
        <div class="mt-7 grid gap-3">
          {faq.map((item) => (
            <article class="rounded-lg border border-border bg-bg-card p-5">
              <h3 class="text-xl font-black text-text">{item.q}</h3>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</PageLayout>
