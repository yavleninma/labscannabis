---
import PageLayout from "@/layouts/PageLayout.astro";
import MapBlock from "@/components/MapBlock.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { ADDRESS, BRAND, CONTACT, GOOGLE } from "@/data/site";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
type Copy = { title: string; description: string; h1: string; bridge: string; lead: string; maps: string; address: string; phone: string; contact: string; legal: string; walking: string };
const copy: Record<Locale, Copy> = {
  en: {
    title: "Labs Cannabis location in Pattaya | Maps and address",
    description: "Find the live LABS DISPENSARY Google Maps listing, published address and phone for Labs Cannabis in Pattaya.",
    h1: "Labs Cannabis location in Pattaya",
    bridge: "Listed on Google Maps as LABS DISPENSARY",
    lead: "Use the live Maps listing for the current pin and route. Hours and review information can change, so they are not duplicated here.",
    maps: "Open Google Maps",
    address: "Published address",
    phone: "Phone",
    contact: "Contact and visit coordination",
    legal: "Current rules for tourists",
    walking: "Directions from Walking Street",
  },
  ru: {
    title: "Локация Labs Cannabis в Паттайе | Maps и адрес",
    description: "Актуальная карточка LABS DISPENSARY в Google Maps, опубликованный адрес и телефон Labs Cannabis в Паттайе.",
    h1: "Локация Labs Cannabis в Паттайе",
    bridge: "В Google Maps указано название LABS DISPENSARY",
    lead: "Текущий пин и маршрут смотрите в живой карточке Maps. Часы и отзывы могут меняться, поэтому мы не дублируем их здесь.",
    maps: "Открыть Google Maps",
    address: "Опубликованный адрес",
    phone: "Телефон",
    contact: "Контакты и координация визита",
    legal: "Актуальные правила для туристов",
    walking: "Маршрут от Walking Street",
  },
  th: {
    title: "ที่ตั้ง Labs Cannabis ในพัทยา | Maps และที่อยู่",
    description: "ดูรายการ LABS DISPENSARY ใน Google Maps ที่อยู่และโทรศัพท์ที่เผยแพร่ของ Labs Cannabis ในพัทยา",
    h1: "ที่ตั้ง Labs Cannabis ในพัทยา",
    bridge: "แสดงใน Google Maps ในชื่อ LABS DISPENSARY",
    lead: "ใช้ Maps สำหรับหมุดและเส้นทางปัจจุบัน เวลาเปิดและรีวิวอาจเปลี่ยนแปลง จึงไม่แสดงซ้ำที่นี่",
    maps: "เปิด Google Maps",
    address: "ที่อยู่ที่เผยแพร่",
    phone: "โทรศัพท์",
    contact: "ติดต่อและประสานการมาเยือน",
    legal: "กฎปัจจุบันสำหรับนักท่องเที่ยว",
    walking: "เส้นทางจาก Walking Street",
  },
  ar: {
    title: "موقع Labs Cannabis في باتايا | Maps والعنوان",
    description: "بطاقة LABS DISPENSARY المباشرة على Google Maps والعنوان والهاتف المنشوران لـ Labs Cannabis في باتايا.",
    h1: "موقع Labs Cannabis في باتايا",
    bridge: "مدرج على Google Maps باسم LABS DISPENSARY",
    lead: "استخدم بطاقة Maps للدبوس والمسار الحاليين. قد تتغير الساعات والمراجعات لذلك لا نكررها هنا.",
    maps: "افتح Google Maps",
    address: "العنوان المنشور",
    phone: "الهاتف",
    contact: "الاتصال وتنسيق الزيارة",
    legal: "القواعد الحالية للسياح",
    walking: "الاتجاهات من Walking Street",
  },
  zh: {
    title: "Labs Cannabis 芭提雅位置 | Maps 与地址",
    description: "查看 Google Maps 上实时的 LABS DISPENSARY 页面，以及 Labs Cannabis 在芭提雅公开的地址和电话。",
    h1: "Labs Cannabis 在芭提雅的位置",
    bridge: "Google Maps 当前显示为 LABS DISPENSARY",
    lead: "请使用实时 Maps 页面查看当前定位和路线。营业时间与评价可能变化，因此这里不重复显示。",
    maps: "打开 Google Maps",
    address: "公开地址",
    phone: "电话",
    contact: "联系与到店协调",
    legal: "游客当前规则",
    walking: "从 Walking Street 前往",
  },
  ko: {
    title: "파타야 Labs Cannabis 위치 | Maps와 주소",
    description: "Google Maps의 실시간 LABS DISPENSARY 정보와 파타야 Labs Cannabis의 공개 주소 및 전화번호를 확인하세요.",
    h1: "파타야 Labs Cannabis 위치",
    bridge: "Google Maps에는 LABS DISPENSARY로 표시됩니다",
    lead: "현재 핀과 경로는 실시간 Maps 정보를 사용하세요. 영업시간과 리뷰는 변경될 수 있어 여기에 반복하지 않습니다.",
    maps: "Google Maps 열기",
    address: "공개 주소",
    phone: "전화",
    contact: "연락 및 방문 조율",
    legal: "관광객을 위한 현재 규정",
    walking: "Walking Street에서 오는 길",
  },
  ja: {
    title: "パタヤの Labs Cannabis 所在地 | Maps と住所",
    description: "Google Maps の最新 LABS DISPENSARY リスティングと、パタヤの Labs Cannabis の公開住所・電話番号。",
    h1: "パタヤの Labs Cannabis 所在地",
    bridge: "Google Maps では LABS DISPENSARY と表示されています",
    lead: "現在のピンと経路は Maps の最新情報をご利用ください。営業時間やレビューは変わるため、ここでは掲載しません。",
    maps: "Google Maps を開く",
    address: "公開住所",
    phone: "電話",
    contact: "連絡先と来店調整",
    legal: "旅行者向けの現在のルール",
    walking: "Walking Street からの経路",
  },
};
const text = copy[locale] ?? copy.en;
const formattedAddress = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;
---

<PageLayout locale={locale} pathSuffix="locations" title={text.title} description={text.description} pageType="locations">
  <main class="px-4 py-10">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{text.h1}</h1>
      <p class="mt-3 text-sm font-bold uppercase tracking-wide text-emerald-dim">{text.bridge}</p>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{text.lead}</p>

      <dl class="card-surface mt-7 space-y-4 p-5">
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.address}</dt>
          <dd class="mt-1 text-base text-text">{formattedAddress}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.phone}</dt>
          <dd class="mt-1 text-base text-text"><a
            href={CONTACT.tel}
            data-track="contact_call_click"
            data-track-placement="locations_page"
            data-track-detail="locations:phone"
          >{CONTACT.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">Website</dt>
          <dd class="mt-1 text-base text-text">{BRAND.domain}</dd>
        </div>
      </dl>

      <nav class="mt-7 grid gap-3" aria-label={text.h1}>
        <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black" data-track="map_open_click" data-track-placement="locations_page" data-track-detail="locations:maps">{text.maps}</a>
        <a href={localePath(locale, "labs-dispensary-pattaya")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="local_intent_click" data-track-placement="locations_page" data-track-detail="locations:labs-dispensary" data-seo-context-link>{text.bridge}</a>
        <a href={localePath(locale, "contact")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.contact}</a>
        <a href={localePath(locale, "guides/legal-cannabis-tourists")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.legal}</a>
        {(locale === "en" || locale === "ru") && (
          <>
            <a href={localePath(locale, "cannabis-near-me-pattaya")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="local_intent_click" data-track-placement="locations_page" data-track-detail="locations:near-me" data-seo-context-link>{locale === "ru" ? "Магазин каннабиса рядом в Паттайе" : "Cannabis shop near me in Pattaya"}</a>
            <a href={localePath(locale, "areas/walking-street")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="local_intent_click" data-track-placement="locations_page" data-track-detail="locations:walking-street" data-seo-context-link>{text.walking}</a>
            <a href={localePath(locale, "delivery/pattaya")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="local_intent_click" data-track-placement="locations_page" data-track-detail="locations:delivery-rules" data-seo-context-link>{locale === "ru" ? "Актуальные правила доставки в Паттайе" : "Current delivery rules in Pattaya"}</a>
          </>
        )}
      </nav>
    </div>
  </main>
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix="locations" />
</PageLayout>
