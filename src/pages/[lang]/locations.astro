---
import PageLayout from "@/layouts/PageLayout.astro";
import MapBlock from "@/components/MapBlock.astro";
import ContactRail from "@/components/ContactRail.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { ADDRESS, BRAND, CONTACT, GOOGLE } from "@/data/site";
import { getIndexPolicy } from "@/lib/index-policy.mjs";
import { t } from "@/lib/ui";
import { LOCATIONS_COPY } from "@/data/visit-copy";
import { describeLandmarkWalk, getLandmark } from "@/lib/geo";
import { renderCopy } from "@/data/area-copy";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const text = LOCATIONS_COPY[locale] ?? LOCATIONS_COPY.en;
const ui = t(locale);
const formattedAddress = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;

/**
 * Маршруты. Название ориентира и строка расстояния приходят из `src/lib/geo.ts`
 * — гаверсинус от пина магазина, а не рука копирайтера: обещание «5 минут
 * пешком» до Walking Street возвращается однозвёздочным отзывом, потому что
 * там 800 м. Ориентир без координат просто не рендерится.
 */
const routes = text.routes
  .map((route) => ({
    name: getLandmark(route.slug)?.name[locale] ?? null,
    walk: describeLandmarkWalk(route.slug, locale),
    body: route.body,
  }))
  .filter((route): route is { name: string; walk: string; body: string } =>
    Boolean(route.name && route.walk),
  );

/** Те же вычисленные строки внутри FAQ — иначе цифра разъедется с разметкой. */
const walkVars = {
  walkingStreet: describeLandmarkWalk("walking-street", locale) ?? "",
  jomtien: describeLandmarkWalk("jomtien-beach", locale) ?? "",
};
const faq = text.faq.map((item) => ({ q: item.q, a: renderCopy(item.a, walkVars) }));

const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.footerSeo.allPages, pathSuffix: "locations" },
];

/**
 * Хаб перелинковки. Возвращённая в индекс страница без входящей ссылки на своей
 * локали остаётся сиротой, поэтому список фильтруется политикой индексации, а не
 * захардкоженным `locale === "en" || locale === "ru"`: добавили слаг в
 * `INDEX_POLICY_RULES` — ссылка появилась ровно на тех локалях, где цель
 * indexable. Ссылку на noindex-цель `scripts/check-seo.mjs` валит.
 */
const intentLinks = [
  { suffix: "cannabis-near-me-pattaya", label: ui.footerSeo.nearMe },
  { suffix: "buy-cannabis-pattaya", label: ui.footerSeo.buyPattaya },
  { suffix: "best-cannabis-shop-pattaya", label: ui.footerSeo.bestShop },
  { suffix: "cheap-weed-pattaya", label: ui.footerSeo.priceFactors },
  { suffix: "areas/walking-street", label: text.walking },
  { suffix: "areas/soi-buakhao", label: ui.footerSeo.soiBuakhaoRoute },
  { suffix: "areas/central-pattaya", label: ui.footerSeo.centralPattayaRoute },
  { suffix: "areas/jomtien", label: ui.footerSeo.jomtienRoute },
  { suffix: "delivery/pattaya", label: ui.footerSeo.pattayaDelivery },
  { suffix: "about", label: ui.footerSeo.aboutUs },
  { suffix: "guides", label: ui.footerSeo.guidesHub },
  { suffix: "strains", label: ui.footerSeo.strainsHub },
  /*
    Кластер маршрутов от ориентиров (`getting-here/*`). `locations` объявлен его
    хабом, а хаб на этом сайте ведётся руками — поэтому слаги перечислены здесь,
    а не подмешиваются из кластера. Ручной остаётся только СТРОКА: попадёт ли
    ссылка на страницу, решает `getIndexPolicy` ниже, то есть ворота качества.
    Не прошедший ворота маршрут исчезает отсюда сам, и его страница перестаёт
    быть целью контекстной ссылки, оставаясь живым URL под noindex.
  */
  { suffix: "getting-here/terminal-21", label: ui.footerSeo.routeTerminal21 },
  { suffix: "getting-here/central-marina", label: ui.footerSeo.routeCentralMarina },
  { suffix: "getting-here/north-pattaya-bus-terminal", label: ui.footerSeo.routeBusTerminal },
  { suffix: "getting-here/pattaya-railway-station", label: ui.footerSeo.routeRailwayStation },
  { suffix: "getting-here/u-tapao-airport", label: ui.footerSeo.routeUTapao },
  { suffix: "getting-here/sanctuary-of-truth", label: ui.footerSeo.routeSanctuary },
  { suffix: "getting-here/wong-amat-beach", label: ui.footerSeo.routeWongAmat },
  { suffix: "getting-here/big-buddha", label: ui.footerSeo.routeBigBuddha },
].filter((link) => getIndexPolicy(locale, link.suffix).indexable);
---

<PageLayout
  locale={locale}
  pathSuffix="locations"
  title={text.title}
  description={text.description}
  pageType="locations"
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <main class="px-4 py-10">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{text.h1}</h1>
      <p class="mt-3 text-sm font-bold uppercase tracking-wide text-emerald-dim">{text.bridge}</p>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{text.lead}</p>

      <dl class="card-surface mt-7 space-y-4 p-5">
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.address}</dt>
          <dd class="mt-1 text-base text-text">{formattedAddress}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.phone}</dt>
          <dd class="mt-1 text-base text-text"><a
            href={CONTACT.tel}
            data-track="contact_click"
            data-channel="phone"
            data-placement="locations"
          >{CONTACT.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">Website</dt>
          <dd class="mt-1 text-base text-text">{BRAND.domain}</dd>
        </div>
      </dl>

      <section class="mt-9">
        <h2 class="text-xl font-bold text-emerald-dim">{text.routesTitle}</h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{text.routesIntro}</p>
        <ul class="mt-4 grid gap-4">
          {routes.map((route) => (
            <li class="card-surface p-4">
              <h3 class="text-base font-bold text-text">{route.name}</h3>
              <p class="mt-1 text-sm font-semibold text-emerald-dim">{route.walk}</p>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{route.body}</p>
            </li>
          ))}
        </ul>
      </section>

      {text.sections.map((section) => (
        <section class="mt-9">
          <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
          ))}
        </section>
      ))}

      <section class="mt-9">
        <h2 class="mb-3 text-xl font-bold">{text.faqTitle}</h2>
        {faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>

      <nav class="mt-9 grid gap-3" aria-label={text.h1}>
        <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black" data-track="contact_click" data-channel="maps" data-placement="locations">{text.maps}</a>
        <a href={localePath(locale, "labs-dispensary-pattaya")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="nav_click" data-placement="locations" data-target="labs-dispensary-pattaya" data-seo-context-link>{text.bridge}</a>
        <a href={localePath(locale, "contact")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.contact}</a>
        <a href={localePath(locale, "guides/legal-cannabis-tourists")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.legal}</a>
        {intentLinks.map((link) => (
          <a href={localePath(locale, link.suffix)} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="nav_click" data-placement="locations" data-target={link.suffix} data-seo-context-link>{link.label}</a>
        ))}
      </nav>
    </div>
    <ContactRail locale={locale} intent="visit" placement="rail" />
    <ReviewStrip locale={locale} />
  </main>
  <RelatedLinks locale={locale} pathSuffix="locations" placement="locations" />
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix="locations" />
</PageLayout>
