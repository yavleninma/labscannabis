const text = copy[locale] ?? copy.en;
const ui = t(locale);
const formattedAddress = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;

/**
 * Хаб перелинковки. Возвращённая в индекс страница без входящей ссылки на своей
 * локали остаётся сиротой, поэтому список фильтруется политикой индексации, а не
 * захардкоженным `locale === "en" || locale === "ru"`: добавили слаг в
 * `INDEX_POLICY_RULES` — ссылка появилась ровно на тех локалях, где цель
 * indexable. Ссылку на noindex-цель `scripts/check-seo.mjs` валит.
 */
const intentLinks = [
  { suffix: "cannabis-near-me-pattaya", label: ui.footerSeo.nearMe },
  { suffix: "buy-cannabis-pattaya", label: ui.footerSeo.buyPattaya },
  { suffix: "best-cannabis-shop-pattaya", label: ui.footerSeo.bestShop },
  { suffix: "cheap-weed-pattaya", label: ui.footerSeo.priceFactors },
  { suffix: "areas/walking-street", label: text.walking },
  { suffix: "delivery/pattaya", label: ui.footerSeo.pattayaDelivery },
].filter((link) => getIndexPolicy(locale, link.suffix).indexable);
---

<PageLayout locale={locale} pathSuffix="locations" title={text.title} description={text.description} pageType="locations">
  <main class="px-4 py-10">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{text.h1}</h1>
      <p class="mt-3 text-sm font-bold uppercase tracking-wide text-emerald-dim">{text.bridge}</p>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{text.lead}</p>

      <dl class="card-surface mt-7 space-y-4 p-5">
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.address}</dt>
          <dd class="mt-1 text-base text-text">{formattedAddress}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">{text.phone}</dt>
          <dd class="mt-1 text-base text-text"><a
            href={CONTACT.tel}
            data-track="contact_click"
            data-channel="phone"
            data-placement="locations"
          >{CONTACT.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-emerald-dim">Website</dt>
          <dd class="mt-1 text-base text-text">{BRAND.domain}</dd>
        </div>
      </dl>

      <nav class="mt-7 grid gap-3" aria-label={text.h1}>
        <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black" data-track="contact_click" data-channel="maps" data-placement="locations">{text.maps}</a>
        <a href={localePath(locale, "labs-dispensary-pattaya")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="nav_click" data-placement="locations" data-target="labs-dispensary-pattaya" data-seo-context-link>{text.bridge}</a>
        <a href={localePath(locale, "contact")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.contact}</a>
        <a href={localePath(locale, "guides/legal-cannabis-tourists")} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim">{text.legal}</a>
        {intentLinks.map((link) => (
          <a href={localePath(locale, link.suffix)} class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="nav_click" data-placement="locations" data-target={link.suffix} data-seo-context-link>{link.label}</a>
        ))}
      </nav>
    </div>
    <ContactRail locale={locale} intent="visit" placement="rail" />
    <ReviewStrip locale={locale} />
  </main>
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix="locations" />
</PageLayout>
