---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import Reels from "@/components/Reels.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { AREAS, getAreaBySlug } from "@/data/seo-matrix";
import { AREA_DETAILS, AREA_PAGE_COPY, renderCopy } from "@/data/area-copy";
import { REELS_SLIDES } from "@/data/media";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; area: string } }[] = [];
  for (const lang of LOCALES) {
    for (const area of AREAS) {
      paths.push({ params: { lang, area: area.slug } });
    }
  }
  return paths;
}

const { lang, area: areaSlug } = Astro.params;
const locale = lang as Locale;
const area = getAreaBySlug(areaSlug!)!;
const areaName = area.name[locale];
const details = AREA_DETAILS[area.slug] ?? { etaMinutes: 25, landmarks: [] };
const copy = AREA_PAGE_COPY[locale] ?? AREA_PAGE_COPY.en;
const ui = t(locale);
const vars = { area: areaName, eta: details.etaMinutes };
const title = renderCopy(copy.title, vars);
const description = renderCopy(copy.description, vars);
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.locations.areasGroup, pathSuffix: "locations" },
  { name: areaName, pathSuffix: `areas/${area.slug}` },
];
---

<PageLayout
  locale={locale}
  pathSuffix={`areas/${area.slug}`}
  title={title}
  description={description}
  pageType="area"
  breadcrumbs={breadcrumbs}
  serviceAreaName={areaName}
  includeOfferCatalog={false}
>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold leading-tight">{renderCopy(copy.h1, vars)}</h1>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        {renderCopy(copy.intro, vars)}
      </p>
    </div>
  </section>
  <section class="px-4 py-6">
    <div class="mx-auto max-w-lg">
      <h2 class="text-xl font-bold text-emerald-dim">{copy.whyTitle}</h2>
      <p class="mt-2 text-base leading-relaxed text-text-muted">{renderCopy(copy.whyBody, vars)}</p>

      <h2 class="mt-6 text-xl font-bold text-emerald-dim">{copy.visitTitle}</h2>
      <p class="mt-2 text-base leading-relaxed text-text-muted">{renderCopy(copy.visitBody, vars)}</p>

      {details.landmarks.length > 0 && (
        <div class="mt-6">
          <h2 class="text-xl font-bold text-emerald-dim">{copy.landmarksTitle}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {details.landmarks.map((landmark) => (
              <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-sm text-text-muted">{landmark}</li>
            ))}
          </ul>
        </div>
      )}

      <nav class="mt-6 grid gap-3" aria-label="Related pages">
        <a href={localePath(locale, `delivery/${area.slug}`)} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.delivery} {areaName}
        </a>
        <a href={localePath(locale, "locations")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.allPages}
        </a>
      </nav>
    </div>
  </section>
  <Reels locale={locale} slides={REELS_SLIDES.slice(0, 3)} mini />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix={`areas/${area.slug}`} />
</PageLayout>
