---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import Reels from "@/components/Reels.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { AREAS } from "@/data/seo-matrix";
import { REELS_SLIDES } from "@/data/media";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; area: string } }[] = [];
  for (const lang of LOCALES) {
    for (const area of AREAS) {
      paths.push({ params: { lang, area: area.slug } });
    }
  }
  return paths;
}

const { lang, area: areaSlug } = Astro.params;
const locale = lang as Locale;
const area = AREAS.find((a) => a.slug === areaSlug)!;
const areaName = area.name[locale];
const ui = t(locale);
const title = `Cannabis ${areaName} | Labs Cannabis Pattaya`;
---

<PageLayout locale={locale} pathSuffix={`areas/${areaSlug}`} title={title} description={`Premium cannabis near ${areaName}. White Widow, 1g–1kg tiers. Soi Hollywood shop.`}>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <h1 class="text-2xl font-bold">Cannabis near {areaName}</h1>
      <p class="mt-3 text-sm text-text-muted leading-relaxed">
        Labs Cannabis on Soi Hollywood serves guests from {areaName} and all of Pattaya. Walk in or WhatsApp — weight pricing from 300฿/g to 1kg wholesale.
      </p>
    </div>
  </section>
  <Reels locale={locale} slides={REELS_SLIDES.slice(0, 3)} mini />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} />
</PageLayout>
