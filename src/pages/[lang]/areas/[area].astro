---
import PageLayout from "@/layouts/PageLayout.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import MapBlock from "@/components/MapBlock.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { AREAS, getAreaBySlug } from "@/data/seo-matrix";
import { renderCopy } from "@/data/area-copy";
import { getAreaRoute } from "@/data/area-routes";
import { describeLandmarkWalk } from "@/lib/geo";
import { getMapsDirectionsUrl } from "@/data/site";
import { CTA_LABELS, ctaWhatsAppHref } from "@/data/cta-copy";
import { t } from "@/lib/ui";

/**
 * Страница района = маршрут, а не подстановка названия (T-05).
 *
 * До этой волны шаблон рендерил один и тот же текст на восемь районов, подставляя
 * `{area}`: попарная похожесть основного контента 0.81-0.82, то есть настоящие
 * дубли и doorway-риск. Теперь район попадает в `getStaticPaths` ТОЛЬКО если для
 * него на этой локали написан авторский маршрут в `AREA_ROUTES`. Нет маршрута —
 * нет страницы; прежние URL закрыты 301 в `vercel.json`.
 *
 * Расстояния и время берутся исключительно из `getWalkFromShop()` через
 * `describeLandmarkWalk`: ни одного числа метров или минут в этом файле и в
 * `area-routes.ts` нет и быть не должно.
 */
export function getStaticPaths() {
  const paths: { params: { lang: string; area: string } }[] = [];
  for (const lang of LOCALES) {
    for (const area of AREAS) {
      if (!getAreaRoute(area.slug, lang as Locale)) continue;
      paths.push({ params: { lang, area: area.slug } });
    }
  }
  return paths;
}

const { lang, area: areaSlug } = Astro.params;
const locale = lang as Locale;
const area = getAreaBySlug(areaSlug!)!;
const areaName = area.name[locale];
const route = getAreaRoute(area.slug, locale)!;
const routeWalk = route.landmarkSlug ? describeLandmarkWalk(route.landmarkSlug, locale) : null;
const routeFaq = route.faq.map((item) => ({
  q: item.q,
  a: renderCopy(item.a, { walk: routeWalk ?? "" }),
}));

const ui = t(locale);
const labels = CTA_LABELS[locale];
// Префилл на языке локали и с названием района.
const whatsappUrl = ctaWhatsAppHref(locale, "area", { area: areaName });
const pathSuffix = `areas/${area.slug}`;
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.locations.areasGroup, pathSuffix: "locations" },
  { name: areaName, pathSuffix },
];
---

<PageLayout
  locale={locale}
  pathSuffix={pathSuffix}
  title={route.title}
  description={route.description}
  pageType="area"
  breadcrumbs={breadcrumbs}
  faq={routeFaq}
  serviceAreaName={areaName}
>
  <article class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{route.kicker}</p>
      <h1 class="mt-1 text-3xl font-bold leading-tight">{route.h1}</h1>
      {routeWalk && <p class="mt-2 text-sm font-semibold text-emerald-dim">{routeWalk}</p>}
      <p class="mt-4 text-base leading-relaxed text-text-muted">{route.intro}</p>

      <section class="mt-8">
        <h2 class="text-xl font-bold text-emerald-dim">{route.routeTitle}</h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{route.routeIntro}</p>
        <ol class="mt-4 grid gap-4">
          {route.steps.map((step, index) => (
            <li class="card-surface p-4">
              <h3 class="text-base font-bold text-text">
                <span class="text-emerald-dim">{index + 1}.</span> {step.title}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      {route.sections.map((section) => (
        <section class="mt-9">
          <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
          ))}
        </section>
      ))}

      <section class="mt-9">
        <h2 class="mb-3 text-xl font-bold">{route.faqTitle}</h2>
        {routeFaq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center justify-center rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black" data-track="contact_click" data-channel="whatsapp" data-placement="area">
          {labels.whatsapp}
        </a>
        <a href={getMapsDirectionsUrl()} target="_blank" rel="noopener noreferrer" class="card-surface flex min-h-12 items-center justify-center px-4 py-3.5 text-center text-base font-semibold text-emerald-dim" data-track="contact_click" data-channel="directions" data-placement="area">
          {labels.directions}
        </a>
      </div>

      <nav class="mt-8" aria-label={route.kicker}>
        <a href={localePath(locale, "locations")} class="card-surface block px-4 py-3 text-base font-medium hover:text-emerald-dim" data-track="nav_click" data-placement="area" data-target="locations" data-seo-context-link>{ui.footerSeo.allPages}</a>
      </nav>
    </div>
    <ContactRail locale={locale} intent="area" placement="area" area={areaName} />
  </article>
  <RelatedLinks locale={locale} pathSuffix={pathSuffix} placement="area" />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix={pathSuffix} />
</PageLayout>
