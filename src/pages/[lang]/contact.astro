---
import PageLayout from "@/layouts/PageLayout.astro";
import MapBlock from "@/components/MapBlock.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { ADDRESS, BRAND, CONTACT, GOOGLE } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const copy: Record<Locale, { description: string; lead: string; prefill: string; maps: string }> = {
  en: {
    description: "Contact Labs Cannabis for directions and visit coordination at Pattaya 13 Alley.",
    lead:
      "Use WhatsApp for directions and visit coordination. Open the public Google Maps listing before travelling to the shop.",
    prefill:
      "Hi Labs Cannabis. I am in Pattaya and would like directions and help coordinating a visit to the shop.",
    maps: "Open Google Maps",
  },
  ru: {
    description: "Связь с Labs Cannabis для маршрута и согласования визита на Pattaya 13 Alley.",
    lead:
      "Используйте WhatsApp для маршрута и согласования визита. Перед поездкой откройте публичную карточку в Google Maps.",
    prefill:
      "Привет, Labs Cannabis. Я в Паттайе. Подскажите маршрут и помогите согласовать визит в магазин.",
    maps: "Открыть Google Maps",
  },
  th: {
    description: "ติดต่อ Labs Cannabis เพื่อขอเส้นทางและประสานงานการเยี่ยมชมที่ Pattaya 13 Alley",
    lead:
      "ใช้ WhatsApp เพื่อขอเส้นทางและประสานงานการเยี่ยมชม โปรดเปิดข้อมูลสาธารณะใน Google Maps ก่อนเดินทาง",
    prefill:
      "สวัสดี Labs Cannabis ฉันอยู่ในพัทยาและต้องการเส้นทางพร้อมความช่วยเหลือในการประสานงานการเยี่ยมชมร้าน",
    maps: "เปิด Google Maps",
  },
  ar: {
    description: "تواصل مع Labs Cannabis للحصول على الاتجاهات وتنسيق الزيارة إلى Pattaya 13 Alley.",
    lead:
      "استخدم WhatsApp للحصول على الاتجاهات وتنسيق الزيارة. افتح بطاقة Google Maps العامة قبل التوجه إلى المتجر.",
    prefill:
      "مرحباً Labs Cannabis. أنا في باتايا وأرغب في الاتجاهات والمساعدة في تنسيق زيارة المتجر.",
    maps: "فتح Google Maps",
  },
  zh: {
    description: "联系 Labs Cannabis，获取前往 Pattaya 13 Alley 的路线并协调到店。",
    lead:
      "使用 WhatsApp 获取路线并协调到店。出发前请打开公开的 Google Maps 商家信息。",
    prefill:
      "你好，Labs Cannabis。我在芭提雅，希望获取路线并协调到店。",
    maps: "打开 Google Maps",
  },
  ko: {
    description: "Labs Cannabis에 Pattaya 13 Alley 길 안내와 방문 조율을 문의하세요.",
    lead:
      "WhatsApp으로 길 안내와 방문 조율을 문의하세요. 출발 전에 공개 Google Maps 정보를 확인하세요.",
    prefill:
      "안녕하세요, Labs Cannabis. 파타야에 있으며 매장 길 안내와 방문 조율을 부탁드립니다.",
    maps: "Google Maps 열기",
  },
  ja: {
    description: "Labs Cannabisへ、Pattaya 13 Alleyまでの道順と来店調整を問い合わせ。",
    lead:
      "WhatsAppで道順と来店調整を確認できます。出発前に公開Google Maps情報を開いてください。",
    prefill:
      "こんにちは、Labs Cannabis。パタヤにいます。店舗までの道順と来店調整をお願いします。",
    maps: "Google Mapsを開く",
  },
};
const contactCopy = copy[locale] ?? copy.en;
const inquiryHref = `${CONTACT.whatsappWithMsg(contactCopy.prefill)}&source=contact`;
const addressLine = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.contact.title, pathSuffix: "contact" },
];
---

<PageLayout
  locale={locale}
  pathSuffix="contact"
  title={`${ui.contact.title} | Labs Cannabis`}
  description={contactCopy.description}
  pageType="contact"
  breadcrumbs={breadcrumbs}
>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold">{ui.contact.title}</h1>
      <p class="mt-2 text-base text-text-muted">
        {contactCopy.lead}
      </p>
      <div class="mt-5 rounded-xl border border-border bg-bg-card p-4">
        <p class="font-bold text-text">{BRAND.name} — listed on Google Maps as {GOOGLE.listingName}</p>
        <address class="mt-2 not-italic leading-relaxed text-text-muted">{addressLine}</address>
        <a href={CONTACT.tel} class="mt-2 inline-flex font-bold text-text hover:text-emerald-dim" data-track="contact_call_click" data-track-placement="contact" data-track-detail="contact:nap_phone">{CONTACT.phoneDisplay}</a>
        <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block font-bold text-emerald-dim hover:underline" data-track="map_open_click" data-track-placement="contact" data-track-detail="contact:nap_maps">{contactCopy.maps}</a>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <a href={inquiryHref} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald py-3.5 text-center text-base font-bold text-black" data-track="contact_whatsapp_click" data-track-placement="contact" data-track-detail="contact:whatsapp" data-wa-source="contact" data-whatsapp-ref="visit_coordination" data-utm-campaign="contact">{ui.contact.whatsapp}</a>
        <a href={CONTACT.telegram} target="_blank" rel="noopener noreferrer" class="card-surface py-3.5 text-center text-base font-medium" data-track="contact_messenger_click" data-track-placement="contact_page" data-track-detail="contact:telegram">{ui.contact.telegram}</a>
        <a href={CONTACT.line} target="_blank" rel="noopener noreferrer" class="card-surface py-3.5 text-center text-base font-medium" data-track="contact_messenger_click" data-track-placement="contact_page" data-track-detail="contact:line">{ui.contact.line}</a>
        <a href={CONTACT.tel} class="card-surface py-3.5 text-center text-base font-medium" data-track="contact_call_click" data-track-placement="contact_page" data-track-detail="contact:call">{ui.contact.call}</a>
      </div>
    </div>
  </section>
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix="contact" />
</PageLayout>
