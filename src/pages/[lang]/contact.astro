---
import PageLayout from "@/layouts/PageLayout.astro";
import MapBlock from "@/components/MapBlock.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { ADDRESS, BRAND, CONTACT, GOOGLE } from "@/data/site";
import { t } from "@/lib/ui";
import { renderCopy } from "@/data/area-copy";
import { CONTACT_COPY } from "@/data/visit-copy";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const contactCopy = CONTACT_COPY[locale] ?? CONTACT_COPY.en;
const addressLine = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;
/**
 * Title без города и бренда («Get in touch | Labs Cannabis») не отвечал ни на
 * один запрос, по которому страницу ищут. Лимит `MAX_TITLE_LENGTH` — 75
 * символов, поэтому строка собирается из готовых кусков и проверяется чекером.
 */
const contactTitle = `${ui.contact.title} — LABS DISPENSARY Pattaya | Labs Cannabis`;
/** Та же локализованная строка, что в футере и на главной, а не английский литерал. */
const listedAs = renderCopy(ui.footer.listedAs, { brand: BRAND.name, listing: GOOGLE.listingName });
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.contact.title, pathSuffix: "contact" },
];
---

<PageLayout
  locale={locale}
  pathSuffix="contact"
  title={contactTitle}
  description={contactCopy.description}
  pageType="contact"
  breadcrumbs={breadcrumbs}
  faq={contactCopy.faq}
>
  <main>
    <section class="px-4 pt-8">
      <div class="mx-auto max-w-lg">
        <h1 class="text-3xl font-bold">{ui.contact.title}</h1>
        <p class="mt-2 text-base text-text-muted">
          {contactCopy.lead}
        </p>
        <div class="mt-5 rounded-xl border border-border bg-bg-card p-4">
          <p class="font-bold text-text">{listedAs}</p>
          <address class="mt-2 not-italic leading-relaxed text-text-muted">{addressLine}</address>
          <a href={CONTACT.tel} class="mt-2 inline-flex font-bold text-text hover:text-emerald-dim" data-track="contact_click" data-channel="phone" data-placement="contact">{CONTACT.phoneDisplay}</a>
          <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block font-bold text-emerald-dim hover:underline" data-track="contact_click" data-channel="maps" data-placement="contact">{contactCopy.maps}</a>
        </div>
      </div>
      <div class="mx-auto mt-9 max-w-lg">
        {/*
          Собственный текст страницы. До волны 2 здесь было 64-79 слов на локаль:
          человек, дошедший до «Связаться», получал номер и ничего из того, что
          он на самом деле собирался спросить.
        */}
        {contactCopy.sections.map((section) => (
          <section class="mt-8">
            <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
            {section.body.map((paragraph) => (
              <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
            ))}
          </section>
        ))}

        <section class="mt-9">
          <h2 class="mb-3 text-xl font-bold">{contactCopy.faqTitle}</h2>
          {contactCopy.faq.map((item) => (
            <details class="card-surface mb-3 p-4">
              <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </section>
      </div>
    </section>
    {/* Каналы, их подписи и флаги LINE/Telegram живут в одном месте — ContactRail. */}
    <ContactRail locale={locale} intent="visit" placement="contact" />
    <RelatedLinks locale={locale} pathSuffix="contact" placement="contact" />
  </main>
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix="contact" />
</PageLayout>
