---
import PageLayout from "@/layouts/PageLayout.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { CONTACT } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
---

<PageLayout locale={locale} pathSuffix="contact" title={`${ui.contact.title} | Labs Cannabis`} description={ui.contact.subtitle}>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <h1 class="text-2xl font-bold">{ui.contact.title}</h1>
      <p class="mt-2 text-sm text-text-muted">{ui.contact.subtitle}</p>
      <p class="mt-4 text-lg font-semibold">{CONTACT.phoneDisplay}</p>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-emerald py-3 text-center text-sm font-semibold text-black">{ui.contact.whatsapp}</a>
        <a href={CONTACT.telegram} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-border py-3 text-center text-sm">{ui.contact.telegram}</a>
        <a href={CONTACT.line} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-border py-3 text-center text-sm">{ui.contact.line}</a>
        <a href={CONTACT.tel} class="rounded-xl border border-border py-3 text-center text-sm">{ui.contact.call}</a>
      </div>
    </div>
  </section>
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} />
</PageLayout>
