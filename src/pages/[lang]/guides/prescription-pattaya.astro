---
import GuideArticle from "@/components/GuideArticle.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { PRESCRIPTION_GUIDE } from "@/data/guide-prescription";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = PRESCRIPTION_GUIDE[locale];
---

<GuideArticle
  locale={locale}
  pathSuffix="guides/prescription-pattaya"
  copy={copy}
  placement="guides"
  intent="prescription"
/>
