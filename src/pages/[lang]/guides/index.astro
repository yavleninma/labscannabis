---
import PageLayout from "@/layouts/PageLayout.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { GUIDES_INDEX_COPY } from "@/data/guides-index";
import { GUIDES_UPDATED_ON } from "@/data/guides";
import { formatUpdatedLabel } from "@/lib/updated-date";
import { PRESCRIPTION_GUIDE } from "@/data/guide-prescription";
import { getIndexPolicy } from "@/lib/index-policy.mjs";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = GUIDES_INDEX_COPY[locale] ?? GUIDES_INDEX_COPY.en;
const ui = t(locale);
const pathSuffix = "guides";
/**
 * Ссылка на гайд появляется ровно там, где он indexable: `choosing-flower`
 * написан на en+ru, и на тайской странице ссылки на него быть не должно —
 * контекстную ссылку на noindex-цель `scripts/check-seo.mjs` валит.
 */
/** Дата обновления кластера — одна строка на локаль, уже вычитанная в гайдах. */
const updatedLabel = formatUpdatedLabel(locale, GUIDES_UPDATED_ON);
const items = copy.items.filter((item) => getIndexPolicy(locale, item.suffix).indexable);
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: copy.kicker, pathSuffix },
];
---

<PageLayout
  locale={locale}
  pathSuffix={pathSuffix}
  title={copy.title}
  description={copy.description}
  pageType="guide"
  breadcrumbs={breadcrumbs}
  faq={copy.faq}
>
  <main class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{copy.kicker}</p>
      <h1 class="mt-1 text-3xl font-bold leading-tight">{copy.h1}</h1>
      <p class="mt-2 text-sm text-text-muted">
        <time datetime={GUIDES_UPDATED_ON}>{updatedLabel}</time>
      </p>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{copy.lead}</p>

      <section class="mt-8" aria-labelledby="guides-list-title">
        <h2 id="guides-list-title" class="text-xl font-bold text-emerald-dim">{copy.itemsTitle}</h2>
        <ul class="mt-4 grid gap-4">
          {items.map((item) => (
            <li class="card-surface p-4">
              <a
                href={localePath(locale, item.suffix)}
                class="text-base font-bold text-emerald-dim hover:underline"
                data-track="nav_click"
                data-placement="guides"
                data-target={item.suffix}
                data-seo-context-link
              >{item.label}</a>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.blurb}</p>
            </li>
          ))}
        </ul>
      </section>

      {copy.sections.map((section) => (
        <section class="mt-9">
          <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
          ))}
        </section>
      ))}

      <section class="mt-9">
        <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
        {copy.faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>
    </div>
    <ContactRail locale={locale} intent="prescription" placement="guides" />
  </main>
  <RelatedLinks locale={locale} pathSuffix={pathSuffix} placement="guides" />
  <Footer locale={locale} pathSuffix={pathSuffix} />
</PageLayout>
