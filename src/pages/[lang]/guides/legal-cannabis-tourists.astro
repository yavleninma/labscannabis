---
import PageLayout from "@/layouts/PageLayout.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import {
  LEGAL_GUIDE_COPY,
  LEGAL_GUIDE_PUBLISHED_ON,
  LEGAL_GUIDE_SOURCES,
} from "@/data/legal-guide";
import { GUIDES_UPDATED_ON } from "@/data/guides";
import { t } from "@/lib/ui";
import { formatUpdatedLabel } from "@/lib/updated-date";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const copy = LEGAL_GUIDE_COPY[locale];
const pathSuffix = "guides/legal-cannabis-tourists";
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: copy.breadcrumb, pathSuffix },
];
const updatedLabel = formatUpdatedLabel(locale, GUIDES_UPDATED_ON);
const article = {
  headline: copy.h1,
  datePublished: LEGAL_GUIDE_PUBLISHED_ON,
  dateModified: GUIDES_UPDATED_ON,
};
---

<PageLayout
  locale={locale}
  pathSuffix={pathSuffix}
  title={copy.title}
  description={copy.description}
  faq={copy.faq}
  pageType="guide"
  breadcrumbs={breadcrumbs}
  article={article}
>
  <article class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <h1 class="mt-1 text-3xl font-bold leading-tight">{copy.h1}</h1>
      {/*
        Ровно одна видимая дата. Раньше их было две — «источники сверены 16
        августа» над заголовком и «обновлено 28 августа» под ним, — и читатель
        правовой страницы видел расхождение там, где дата и есть весь сигнал
        доверия. Строка про сверку снята: она заявляла проделанную работу,
        которую нельзя подтвердить из окружения сборки.
      */}
      <p class="mt-2 text-sm text-text-muted">
        <time datetime={GUIDES_UPDATED_ON}>{updatedLabel}</time>
      </p>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{copy.intro}</p>

      <section class="mt-8" aria-labelledby="official-facts-title">
        <h2 id="official-facts-title" class="text-xl font-bold text-emerald-dim">{copy.factsTitle}</h2>
        <ul class="mt-3 grid gap-3">
          {copy.facts.map((fact) => (
            <li class="card-surface px-4 py-3 text-base leading-relaxed text-text-muted">{fact}</li>
          ))}
        </ul>

        {/*
          Первоисточники — сноски, а не кнопки. Раньше самой заметной кнопкой на
          самой горячей странице была зелёная ссылка на тайскоязычный сайт
          правительства: посетитель уходил с сайта и не возвращался. Ссылки нужны
          (без них гайд не гайд), но вес у них должен быть как у сноски.
        */}
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-text-muted">
          <a
            href={LEGAL_GUIDE_SOURCES.thaiGovernment}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="underline hover:text-emerald-dim"
          >
            {copy.governmentSourceCta}
          </a>
          <a
            href={LEGAL_GUIDE_SOURCES.touristNotice}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="underline hover:text-emerald-dim"
          >
            {copy.touristSourceCta}
          </a>
          <a
            href={LEGAL_GUIDE_SOURCES.ministerialRegulation2026}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="underline hover:text-emerald-dim"
          >
            {copy.ministerialSourceCta}
          </a>
        </p>
      </section>

      {/*
        Разделы гайда. `basis` печатается видимо: пересказ уведомления и
        практическая осторожность — разные вещи, и смешивать их означает
        выдавать догадку за норму. Читатель должен видеть, что именно он читает.
      */}
      {copy.sections.map((section) => (
        <section class="mt-9">
          <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-text-muted">
            {copy.basisLabels[section.basis]}
          </p>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
          ))}
        </section>
      ))}

      <aside class="card-surface mt-8 border border-border px-4 py-4" aria-labelledby="legal-caution-title">
        <h2 id="legal-caution-title" class="text-xl font-bold">{copy.cautionTitle}</h2>
        <p class="mt-2 text-base leading-relaxed text-text-muted">{copy.caution}</p>
      </aside>

      <section class="mt-8">
        <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
        {copy.faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>
    </div>
    <ContactRail locale={locale} intent="prescription" placement="legal_guide" />
  </article>
  <RelatedLinks locale={locale} pathSuffix={pathSuffix} placement="legal_guide" />
  <Footer locale={locale} pathSuffix={pathSuffix} />
</PageLayout>
