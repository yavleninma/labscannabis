const { lang } = Astro.params;
const locale = lang as Locale;
const copy = COPY[locale] ?? COPY.en;
const source = "wholesale_quote";
const wholesaleHref = CONTACT.whatsappWithMsg(`${copy.whatsapp}\nsource=${source}`);
const breadcrumbs = [
  { name: locale === "en" ? "Home" : "Labs", pathSuffix: "" },
  { name: copy.breadcrumb, pathSuffix: "wholesale" },
];
---

<PageLayout
  locale={locale}
  pathSuffix="wholesale"
  title={copy.title}
  description={copy.description}
  keywords={[
    "cannabis wholesale Thailand",
    "bulk cannabis flower Thailand",
    "wholesale flower lots",
    "cannabis batch list",
    "COA cannabis Thailand",
  ]}
  faq={copy.faq}
  pageType="wholesale"
  breadcrumbs={breadcrumbs}
>
  <main>
    <section class="relative isolate overflow-hidden bg-text text-white">
      <img
        src="/media/IMG_20260517_175646.webp"
        alt="Cannabis flower batch close-up"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 -z-10 bg-black/64"></div>
      <div class="mx-auto flex min-h-[calc(100svh-4.5rem)] max-w-6xl flex-col justify-center px-4 py-12 sm:min-h-[620px] sm:py-16 md:py-20">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald">{copy.heroEyebrow}</p>
          <h1 class="mt-3 text-4xl font-black leading-tight md:text-6xl">{copy.h1}</h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/88">{copy.lead}</p>
        </div>
        <a
          href={wholesaleHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex w-full items-center justify-center rounded-lg bg-emerald px-5 py-3.5 text-base font-black text-black shadow-lg shadow-black/20 sm:w-auto"
          data-track="contact_whatsapp_click"
          data-whatsapp-source={source}
          data-whatsapp-ref="hero_batch_list"
          data-utm-campaign={source}
        >
          {copy.cta}
        </a>
        <ul class="mt-6 grid gap-3 text-sm font-bold text-white/92 sm:grid-cols-3">
          {copy.chips.map((chip) => (
            <li class="rounded-lg border border-white/22 bg-black/24 px-4 py-3">{chip}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-bg py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.batchEyebrow}</p>
        <h2 class="mt-2 text-3xl font-black leading-tight text-text md:text-5xl">{copy.batchTitle}</h2>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg">{copy.batchLead}</p>
        <div class="mt-7 grid gap-4 md:grid-cols-2">
          {copy.batchCards.map((item) => (
            <article class="rounded-lg border border-border bg-bg-card p-5 shadow-sm shadow-black/5">
              <h3 class="text-xl font-black text-text">{item.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-bg-elevated py-12 md:py-16">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.volumeEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight text-text md:text-5xl">{copy.volumeTitle}</h2>
          <p class="mt-3 text-base leading-relaxed text-text-muted md:text-lg">{copy.volumeLead}</p>
        </div>
        <div class="space-y-3">
          {copy.volumeBands.map((item) => (
            <article class="rounded-lg border border-border bg-bg-card p-5">
              <h3 class="text-lg font-black text-text">{item.label}</h3>
              <p class="mt-1.5 text-base leading-relaxed text-text-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-bg py-12 md:py-16">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald-dim">{copy.gradeEyebrow}</p>
          <h2 class="mt-2 text-3xl font-black leading-tight text-text md:text-5xl">{copy.gradeTitle}</h2>
          <p class="mt-3 text-base leading-relaxed text-text-muted md:text-lg">{copy.gradeLead}</p>
        </div>
        <div class="rounded-lg border border-border bg-bg-card p-5">
          <ul class="grid gap-3 sm:grid-cols-2">
            {copy.cultivationTypes.map((item) => (
              <li class="rounded-lg border border-border bg-bg-elevated px-4 py-3 text-base font-bold text-text">{item}</li>
            ))}
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-text-muted">{copy.docsNote}</p>
        </div>
      </div>
    </section>

    <section id="wholesale-quote" class="bg-text py-12 text-white md:py-16">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-emerald">{copy.flowEyebrow}</p>
            <h2 class="mt-2 text-3xl font-black leading-tight md:text-5xl">{copy.flowTitle}</h2>
            <p class="mt-3 text-base leading-relaxed text-white/78 md:text-lg">{copy.flowLead}</p>
            <a
              href={wholesaleHref}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-emerald px-5 py-3.5 text-base font-black text-black sm:w-auto"
              data-track="contact_whatsapp_click"
              data-whatsapp-source={source}
              data-whatsapp-ref="quote_steps"
              data-utm-campaign={source}
            >
              {copy.cta}
            </a>
          </div>
          <ol class="grid gap-3">
            {copy.steps.map((step, index) => (
              <li class="rounded-lg border border-white/16 bg-white/8 p-5">
                <p class="text-sm font-bold text-emerald">{copy.stepLabel} {index + 1}</p>
                <p class="mt-2 text-base leading-relaxed text-white/86">{step}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} pathSuffix="wholesale" />
</PageLayout>
