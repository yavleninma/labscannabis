---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { CONTACT } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.wholesale.title, pathSuffix: "wholesale" },
];
---

<PageLayout
  locale={locale}
  pathSuffix="wholesale"
  title={`${ui.wholesale.title} | Labs Cannabis`}
  description={ui.wholesale.subtitle}
  pageType="wholesale"
  breadcrumbs={breadcrumbs}
>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <h1 class="text-3xl font-bold">{ui.wholesale.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-text-muted">{ui.wholesale.subtitle}</p>
    </div>
  </section>
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix="wholesale" />
</PageLayout>
