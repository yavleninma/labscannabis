---
import PageLayout from "@/layouts/PageLayout.astro";
import ContactRail from "@/components/ContactRail.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import Footer from "@/components/Footer.astro";
import RetiredCommercialPage from "@/components/RetiredCommercialPage.astro";
import { localePath, type Locale } from "@/lib/i18n";
import { STRAINS_INDEX_COPY } from "@/data/strain-pages";
import { getStrainsByFamily, strainPathSuffix } from "@/data/strain-catalog";
import { getAvailableLocales, getIndexPolicy } from "@/lib/index-policy.mjs";
import { t } from "@/lib/ui";

/**
 * Хаб кластера сортов: страница ВЫБОРА, а не перечисления.
 *
 * Двадцать ссылок в один столбик — это оглавление, и человеку у прилавка оно не
 * помогает: он не выбирает между двадцатью именами, он выбирает между пятью
 * запахами. Поэтому список сгруппирован по ароматическим семьям, у каждой
 * группы стоит строка «выбирайте здесь, если», а сорт внутри группы отличается
 * одной фразой от соседей ПО ЭТОЙ ЖЕ ГРУППЕ.
 *
 * СОСТАВ ГРУПП ВЫЧИСЛЯЕТСЯ ИЗ НАБОРА ДАННЫХ. `group.families` — идентификаторы
 * ароматических семей, сорта в них подбирает `getStrainsByFamily()`. Руками
 * написана только проза; ни один слаг в копирайте не перечислен, поэтому новый
 * сорт появляется в хабе одновременно с появлением в данных и не может попасть
 * в две группы сразу.
 *
 * Отфильтровано по политике индексации: сорт, не прошедший ворота качества,
 * остаётся живым URL под `noindex`, но входящей ссылки из хаба не получает.
 *
 * Локали без вычитанного носителем текста страницу не получают вовсе — список
 * берётся из `getAvailableLocales()`, тот же источник, что у переключателя
 * языка, а остальным пяти отвечает 301 в `vercel.json`.
 */
export function getStaticPaths() {
  return getAvailableLocales("strains").map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const copy = STRAINS_INDEX_COPY[locale];
const ui = t(locale);
const pathSuffix = "strains";

const groups = (copy?.groups ?? [])
  .map((group) => ({
    ...group,
    items: group.families
      .flatMap((family) => getStrainsByFamily(family))
      .map((profile) => ({
        suffix: strainPathSuffix(profile.slug),
        label: profile.linkName ?? profile.name,
        blurb: copy?.blurbs[profile.slug] ?? "",
      }))
      .filter((item) => item.blurb && getIndexPolicy(locale, item.suffix).indexable),
  }))
  .filter((group) => group.items.length > 0);

/** Плоский состав хаба для `ItemList`: уже отфильтрован политикой индексации. */
const itemList = groups.flatMap((group) =>
  group.items.map((item) => ({ name: item.label, pathSuffix: item.suffix })),
);

const breadcrumbs = copy
  ? [
      { name: ui.nav.home, pathSuffix: "" },
      { name: copy.kicker, pathSuffix },
    ]
  : [];
---

{copy ? (
  <PageLayout
    locale={locale}
    pathSuffix={pathSuffix}
    title={copy.title}
    description={copy.description}
    pageType="strain"
    breadcrumbs={breadcrumbs}
    faq={copy.faq}
    itemList={itemList}
  >
    <main class="px-4 pt-8 pb-6">
      <div class="mx-auto max-w-lg">
        <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{copy.kicker}</p>
        <h1 class="mt-1 text-3xl font-bold leading-tight">{copy.h1}</h1>
        <p class="mt-4 text-base leading-relaxed text-text-muted">{copy.lead}</p>

        <section class="mt-8" aria-labelledby="strains-list-title">
          <h2 id="strains-list-title" class="text-xl font-bold text-emerald-dim">{copy.itemsTitle}</h2>

          {groups.map((group) => (
            <section class="mt-8">
              <h3 class="text-lg font-bold">{group.h2}</h3>
              {group.body.map((paragraph) => (
                <p class="mt-2 text-base leading-relaxed text-text-muted">{paragraph}</p>
              ))}
              <p class="mt-3 text-base font-semibold leading-relaxed text-emerald-dim">{group.chooseIf}</p>
              <ul class="mt-4 grid gap-4">
                {group.items.map((item) => (
                  <li class="card-surface p-4">
                    <a
                      href={localePath(locale, item.suffix)}
                      class="text-base font-bold text-emerald-dim hover:underline"
                      data-track="nav_click"
                      data-placement="strain"
                      data-target={item.suffix}
                      data-seo-context-link
                    >{item.label}</a>
                    <p class="mt-2 text-base leading-relaxed text-text-muted">{item.blurb}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </section>

        {copy.sections.map((section) => (
          <section class="mt-9">
            <h2 class="text-xl font-bold text-emerald-dim">{section.h2}</h2>
            {section.body.map((paragraph) => (
              <p class="mt-3 text-base leading-relaxed text-text-muted">{paragraph}</p>
            ))}
          </section>
        ))}

        <section class="mt-9">
          <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
          {copy.faq.map((item) => (
            <details class="card-surface mb-3 p-4">
              <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
              <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
            </details>
          ))}
        </section>
      </div>
      <ContactRail locale={locale} intent="menu" placement="strain" />
    </main>
    <RelatedLinks locale={locale} pathSuffix={pathSuffix} placement="strain" />
    <Footer locale={locale} pathSuffix={pathSuffix} />
  </PageLayout>
) : (
  <RetiredCommercialPage locale={locale} pathSuffix={pathSuffix} />
)}
