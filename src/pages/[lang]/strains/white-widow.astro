---
import PageLayout from "@/layouts/PageLayout.astro";
import Reels from "@/components/Reels.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { WHITE_WIDOW } from "@/data/strains";
import { REELS_SLIDES } from "@/data/media";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const desc =
  "General White Widow information for adults asking about lawful medical cannabis access in Pattaya. Availability and suitability cannot be confirmed online.";
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: WHITE_WIDOW.name, pathSuffix: "strains/white-widow" },
];
---

<PageLayout
  locale={locale}
  pathSuffix="strains/white-widow"
  title="White Widow information in Pattaya | Labs Cannabis"
  description={desc}
  pageType="strain"
  breadcrumbs={breadcrumbs}
>
  <section class="px-4 pt-8">
    <div class="mx-auto max-w-lg">
      <span class="text-sm font-semibold uppercase tracking-wider text-emerald-dim">General information</span>
      <h1 class="mt-1 text-3xl font-bold">White Widow information</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{desc}</p>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        This page is not a product offer, medical recommendation, reservation, or online menu. Ask
        what Thai documentation is required before visiting.
      </p>
    </div>
  </section>
  <Reels locale={locale} slides={REELS_SLIDES.slice(0, 4)} mini />
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix="strains/white-widow" />
</PageLayout>
