---
import PageLayout from "@/layouts/PageLayout.astro";
import Reels from "@/components/Reels.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, type Locale } from "@/lib/i18n";
import { WHITE_WIDOW } from "@/data/strains";
import { REELS_SLIDES } from "@/data/media";
import { CONTACT } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const ui = t(locale);
const copy: Record<
  Locale,
  {
    title: string;
    description: string;
    kicker: string;
    h1: string;
    lead: string;
    note: string;
    cta: string;
    prefill: string;
    facts: { label: string; value: string }[];
  }
> = {
  en: {
    title: "White Widow Pattaya | Fresh hybrid strain | Labs Cannabis",
    description:
      "White Widow in Pattaya: balanced hybrid direction, verified 22% THC in current data, fresh menu check, effects, and WhatsApp availability inquiry.",
    kicker: "Flagship strain",
    h1: "White Widow in Pattaya",
    lead:
      "White Widow is the balanced hybrid anchor on the Labs Cannabis menu: clear lift, relaxing finish, frosty indoor look, and an easy first comparison against today's fresh flower.",
    note:
      "Potency, freshness, and availability can change by batch. Ask for today's photos, effects, and current menu notes in WhatsApp before visiting.",
    cta: "Ask White Widow on WhatsApp",
    prefill:
      "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today's White Widow availability, photos, effects, freshness, and pickup/delivery possibilities.",
    facts: [
      { label: "Type", value: "Hybrid" },
      { label: "Verified potency", value: "22% THC in current strain data" },
      { label: "Effects", value: "Uplifting, relaxing, balanced" },
    ],
  },
  ru: {
    title: "White Widow Паттайя | Свежий hybrid strain | Labs Cannabis",
    description:
      "White Widow в Паттайе: balanced hybrid, подтвержденные 22% THC в текущих данных, свежесть, эффекты и availability через WhatsApp.",
    kicker: "Флагманский сорт",
    h1: "White Widow в Паттайе",
    lead:
      "White Widow - базовый balanced hybrid в меню Labs Cannabis: ясный lift, расслабляющий финиш, frosty indoor вид и удобная первая точка сравнения с сегодняшними свежими цветами.",
    note:
      "Потентность, свежесть и доступность зависят от партии. Спросите сегодняшние фото, эффекты и актуальные заметки меню в WhatsApp перед визитом.",
    cta: "Спросить White Widow в WhatsApp",
    prefill:
      "Привет, Labs Cannabis. Мне 20+, я в Паттайе. Пришлите наличие White Widow сегодня, фото, эффекты, свежесть и варианты самовывоза/доставки.",
    facts: [
      { label: "Тип", value: "Hybrid" },
      { label: "Подтвержденная potency", value: "22% THC в текущих данных сорта" },
      { label: "Эффекты", value: "Uplifting, relaxing, balanced" },
    ],
  },
  th: {
    title: "White Widow พัทยา | hybrid strain สด | Labs Cannabis",
    description:
      "White Widow ในพัทยา: balanced hybrid, THC 22% ในข้อมูลปัจจุบัน, เช็คความสด เอฟเฟกต์ และ availability ทาง WhatsApp",
    kicker: "สายพันธุ์หลัก",
    h1: "White Widow ในพัทยา",
    lead:
      "White Widow คือ balanced hybrid หลักในเมนู Labs Cannabis: clear lift, relaxing finish, ลุค indoor แบบ frosty และเหมาะสำหรับเทียบกับดอกสดวันนี้",
    note:
      "potency ความสด และ availability เปลี่ยนได้ตาม batch ถามรูปวันนี้ เอฟเฟกต์ และ notes เมนูล่าสุดใน WhatsApp ก่อนมา",
    cta: "ถาม White Widow ใน WhatsApp",
    prefill:
      "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today's White Widow availability, photos, effects, freshness, and pickup/delivery possibilities.",
    facts: [
      { label: "Type", value: "Hybrid" },
      { label: "Verified potency", value: "22% THC ในข้อมูล strain ปัจจุบัน" },
      { label: "Effects", value: "Uplifting, relaxing, balanced" },
    ],
  },
  ar: {
    title: "White Widow باتايا | Hybrid strain طازج | Labs Cannabis",
    description:
      "White Widow في باتايا: اتجاه balanced hybrid، 22% THC موثق في البيانات الحالية، فحص الطزاجة والتأثيرات والتوفر عبر WhatsApp.",
    kicker: "السلالة الرئيسية",
    h1: "White Widow في باتايا",
    lead:
      "White Widow هو محور balanced hybrid في قائمة Labs Cannabis: clear lift، نهاية مريحة، مظهر indoor frosty، ونقطة مقارنة سهلة مع زهور اليوم الطازجة.",
    note:
      "قد تتغير potency والطزاجة والتوفر حسب الدفعة. اطلب صور اليوم والتأثيرات وملاحظات القائمة الحالية عبر WhatsApp قبل الزيارة.",
    cta: "اسأل عن White Widow عبر WhatsApp",
    prefill:
      "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today's White Widow availability, photos, effects, freshness, and pickup/delivery possibilities.",
    facts: [
      { label: "النوع", value: "Hybrid" },
      { label: "Potency موثقة", value: "22% THC في بيانات السلالة الحالية" },
      { label: "التأثيرات", value: "Uplifting, relaxing, balanced" },
    ],
  },
  zh: {
    title: "芭提雅 White Widow | 新鲜 hybrid strain | Labs Cannabis",
    description:
      "芭提雅 White Widow：balanced hybrid，当前数据验证 22% THC，新鲜度、效果和 availability 可通过 WhatsApp 查询。",
    kicker: "主打品种",
    h1: "芭提雅 White Widow",
    lead:
      "White Widow 是 Labs Cannabis 菜单中的 balanced hybrid anchor：清晰 lift、放松收尾、frosty indoor 外观，也适合作为比较今日新鲜 flower 的第一选择。",
    note:
      "Potency、新鲜度和 availability 会随批次变化。到店前请在 WhatsApp 索取今日照片、效果和当前菜单 notes。",
    cta: "在 WhatsApp 询问 White Widow",
    prefill:
      "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today's White Widow availability, photos, effects, freshness, and pickup/delivery possibilities.",
    facts: [
      { label: "Type", value: "Hybrid" },
      { label: "已验证 potency", value: "当前品种数据为 22% THC" },
