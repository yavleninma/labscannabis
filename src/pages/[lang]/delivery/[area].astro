---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { AREAS, getAreaBySlug } from "@/data/seo-matrix";
import { AREA_DETAILS, DELIVERY_COMPLIANCE_NOTE, DELIVERY_PAGE_COPY, renderCopy } from "@/data/area-copy";
import { LEGAL_GUIDE_SOURCE_URL } from "@/data/legal-guide";
import { CONTACT, getMapsSearchUrl } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; area: string } }[] = [];
  for (const lang of LOCALES) {
    for (const area of AREAS) {
      paths.push({ params: { lang, area: area.slug } });
    }
  }
  return paths;
}

const { lang, area: areaSlug } = Astro.params;
const locale = lang as Locale;
const area = getAreaBySlug(areaSlug!)!;
const areaName = area.name[locale];
const details = AREA_DETAILS[area.slug] ?? { etaMinutes: 25, landmarks: [] };
const copy = DELIVERY_PAGE_COPY[locale] ?? DELIVERY_PAGE_COPY.en;
const compliance = DELIVERY_COMPLIANCE_NOTE[locale] ?? DELIVERY_COMPLIANCE_NOTE.en;
const ui = t(locale);
const vars = { area: areaName, eta: details.etaMinutes };
const title = renderCopy(copy.title, vars);
const description = renderCopy(copy.description, vars);
const h1 = renderCopy(copy.h1, vars);
const intro = renderCopy(copy.intro, vars);
const faq = copy.faq.map((item) => ({
  q: renderCopy(item.q, vars),
  a: renderCopy(item.a, vars),
}));
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: ui.footerSeo.delivery, pathSuffix: "locations" },
  { name: areaName, pathSuffix: `delivery/${area.slug}` },
];
const whatsappUrl = CONTACT.whatsappWithMsg(h1);
---

<PageLayout
  locale={locale}
  pathSuffix={`delivery/${area.slug}`}
  title={title}
  description={description}
  faq={faq}
  pageType="delivery"
  breadcrumbs={breadcrumbs}
  serviceAreaName={areaName}
  includeOfferCatalog={false}
>
  <article class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{ui.footerSeo.delivery}</p>
      <h1 class="mt-1 text-3xl font-bold leading-tight">{h1}</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{intro}</p>

      <section class="mt-5 rounded-xl border border-emerald/35 bg-emerald/10 p-4">
        <h2 class="text-lg font-bold text-emerald-dim">{compliance.title}</h2>
        <p class="mt-2 text-base leading-relaxed text-text-muted">{compliance.text}</p>
        <a
          href={LEGAL_GUIDE_SOURCE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-semibold text-emerald-dim hover:underline"
        >
          {compliance.sourceCta}
        </a>
      </section>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black"
        >
          {copy.cta}
        </a>
        <a
          href={getMapsSearchUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim"
        >
          {copy.maps}
        </a>
      </div>

      <section class="mt-8">
        <h2 class="text-xl font-bold text-emerald-dim">{copy.statusTitle}</h2>
        <div class="mt-3 grid gap-3">
          {[renderCopy(copy.eta, vars), copy.payment, copy.discreet].map((item) => (
            <p class="card-surface px-4 py-3 text-base text-text-muted">{item}</p>
          ))}
        </div>
      </section>

      {details.landmarks.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-bold text-emerald-dim">{areaName}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {details.landmarks.map((landmark) => (
              <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-sm text-text-muted">{landmark}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-8">
        <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
        {faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>

      <nav class="mt-8 grid gap-3" aria-label="Related pages">
        <a href={localePath(locale, `areas/${area.slug}`)} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          Cannabis near {areaName}
        </a>
        <a href={localePath(locale, "locations")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.allPages}
        </a>
      </nav>
    </div>
  </article>
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix={`delivery/${area.slug}`} />
</PageLayout>
