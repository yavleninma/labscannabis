    stock: "القائمة الحالية والتأثيرات والصور والطزاجة يتم فحصها في WhatsApp",
    privateTerms: "لا يوجد public checkout أو دفع أو order form أو شرط توصيل مؤكد على الموقع",
    faqTitle: "أسئلة التوصيل",
    relatedLabel: "صفحات ذات صلة",
    relatedArea: "قائمة القنب قرب {area}",
    faq: [
      {
        q: "هل يمكنني السؤال من {area} قبل الزيارة؟",
        a: "نعم. أرسل منطقتك والوقت والتأثير المفضل وما إذا كنت تريد الاستلام أو فحص إمكانية التوصيل.",
      },
      {
        q: "هل التوصيل مضمون عبر الإنترنت؟",
        a: "لا. إمكانية التوصيل تناقش بشكل خاص بعد فحص المنطقة والوقت والتفاصيل المطلوبة.",
      },
      {
        q: "هل يمكنني زيارة المتجر مباشرة؟",
        a: "نعم. المتجر في Soi Hollywood على مسافة قصيرة من Walking Street.",
      },
    ],
  },
  zh: {
    title: "{area} 大麻配送可能性 | Labs Cannabis 芭提雅",
    description:
      "通过 WhatsApp 向 Labs Cannabis 询问今日菜单、新鲜度、取货时间，以及是否可讨论 {area} 配送可能性。",
    h1: "{area} 大麻配送可能性",
    intro:
      "从 {area} 出发前请先发消息。我们可以分享今日菜单、效果、新鲜 flower notes、取货时间，并私下讨论你的区域配送可能性。",
