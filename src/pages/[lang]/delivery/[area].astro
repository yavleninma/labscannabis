    relatedLabel: "相关页面",
    relatedArea: "{area} 附近大麻菜单",
    faq: [
      {
        q: "可以从 {area} 出发前先问吗？",
        a: "可以。发送你的区域、时间、偏好效果，以及想确认取货还是配送可能性。",
      },
      {
        q: "线上会保证配送吗？",
