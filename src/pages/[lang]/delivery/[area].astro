      "{area} の大麻配送を検索した方へ：このページはオンライン注文や配送を提供していません。タイ政府通知では、大麻花は管理対象のハーブで、電子的手段またはコンピューターネットワーク経由の販売は禁止されています。以下は公式情報の要約と実店舗への経路です。",
    kicker: "公式規則と道順",
    mapsCta: "地図で経路を見る",
    whatsappCta: "来店の道順を問い合わせる",
    whatsappMessage:
      "こんにちは、Labs Cannabis。{area} から実店舗を訪問する予定です。所在地または道順のみ教えてください。オンライン注文や配送の依頼ではありません。",
    scopeTitle: "実店舗への来店情報のみ",
    scopeBody:
      "経路は地図で確認してください。WhatsAppは実店舗への来店調整または道順確認にのみ使用できます。このページではオンライン注文、支払い、受け取り、配送の依頼を受け付けず、メニュー、在庫、価格、製品写真も掲載しません。",
    faqTitle: "オンライン販売規則・道順FAQ",
    relatedLabel: "関連する公式規則と所在地情報",
    legalGuideLabel: "タイ旅行者向け大麻ルール",
    locationsLabel: "実店舗の所在地と道順",
    faq: [
      {
        q: "このページは {area} への大麻配送を提供しますか？",
        a: "いいえ。公式情報に基づく規則説明と道順のページであり、オンライン注文、支払い、受け取り、配送の依頼は受け付けません。",
      },
      {
        q: "公式通知はオンライン販売をどう定めていますか？",
        a: "タイ政府通知は、電子的手段またはコンピューターネットワーク経由の大麻花販売と、あらゆるチャネルでの広告を禁止しています。最新の文言はリンク先の公式情報で確認してください。",
      },
      {
        q: "WhatsAppは何に使えますか？",
        a: "実店舗の所在地確認、道順の問い合わせ、来店調整のみです。注文、支払い、受け取り、配送のためのチャネルではありません。",
      },
    ],
  },
};
const copy = deliveryCopy[locale];
const ui = t(locale);
const isPattayaArea = area.slug === "pattaya";
const vars = {
  area: areaName,
  areaLocative: locale === "ru" && isPattayaArea ? "Паттайе" : areaName,
  areaFrom: locale === "ru" && isPattayaArea ? "Паттайи" : areaName,
  areaDestination: locale === "ru" && isPattayaArea ? "Паттайю" : areaName,
};
const title =
  isPattayaArea && locale === "en"
    ? "Cannabis delivery rules in Pattaya | Labs Cannabis"
    : isPattayaArea && locale === "ru"
      ? "Правила доставки каннабиса в Паттайе | Labs Cannabis"
      : renderCopy(copy.title, vars);
const description = renderCopy(copy.description, vars);
const h1 = renderCopy(copy.h1, vars);
const intro = renderCopy(copy.intro, vars);
const scopeBody = renderCopy(copy.scopeBody, vars);
const faq = copy.faq.map((item) => ({
  q: renderCopy(item.q, vars),
  a: renderCopy(item.a, vars),
}));
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: copy.kicker, pathSuffix: "locations" },
  { name: areaName, pathSuffix: `delivery/${area.slug}` },
];
const whatsappMessage = renderCopy(copy.whatsappMessage, vars);
const whatsappUrl = `${CONTACT.whatsappWithMsg(whatsappMessage)}&source=visit_directions`;
const article = {
  headline: h1,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: "Labs Cannabis",
};
---

<PageLayout
  locale={locale}
  pathSuffix={`delivery/${area.slug}`}
  title={title}
  description={description}
  faq={faq}
  pageType="guide"
  breadcrumbs={breadcrumbs}
  article={article}
>
  <article class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{copy.kicker}</p>
      <h1 class="mt-1 text-3xl font-bold leading-tight">{h1}</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{intro}</p>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <a
          href={getMapsSearchUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black"
          data-track="map_open_click"
          data-track-placement="delivery_rules"
          data-track-detail={`delivery_rules:${area.slug}:maps`}
        >
          {copy.mapsCta}
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim"
          data-track="contact_whatsapp_click"
          data-track-placement="visit_directions"
          data-track-detail={`delivery_rules:${area.slug}:whatsapp_directions`}
          data-wa-source="visit_directions"
          data-whatsapp-ref={`delivery_rules:${area.slug}`}
        >
          {copy.whatsappCta}
        </a>
      </div>

      <section class="mt-8" aria-labelledby="delivery-rules-facts-title">
        <h2 id="delivery-rules-facts-title" class="text-xl font-bold text-emerald-dim">{rulesCopy.factsTitle}</h2>
        <ul class="mt-3 grid gap-3">
          {rulesCopy.facts.map((fact) => (
            <li class="card-surface px-4 py-3 text-base leading-relaxed text-text-muted">{fact}</li>
          ))}
        </ul>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <a
            href={LEGAL_GUIDE_SOURCES.thaiGovernment}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface px-4 py-3 text-center text-base font-semibold text-emerald-dim"
          >
            {rulesCopy.governmentSourceCta}
          </a>
          <a
            href={LEGAL_GUIDE_SOURCES.touristNotice}
            target="_blank"
            rel="noopener noreferrer"
            class="card-surface px-4 py-3 text-center text-base font-semibold text-emerald-dim"
          >
            {rulesCopy.touristSourceCta}
          </a>
        </div>
      </section>

      <aside class="card-surface mt-8 border border-border px-4 py-4" aria-labelledby="delivery-rules-scope-title">
        <h2 id="delivery-rules-scope-title" class="text-xl font-bold">{copy.scopeTitle}</h2>
        <p class="mt-2 text-base leading-relaxed text-text-muted">{scopeBody}</p>
        <h3 class="mt-4 text-base font-bold text-emerald-dim">{rulesCopy.cautionTitle}</h3>
        <p class="mt-2 text-base leading-relaxed text-text-muted">{rulesCopy.caution}</p>
      </aside>

      <section class="mt-8">
        <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
        {faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>

      <nav class="mt-8 grid gap-3" aria-label={copy.relatedLabel}>
        <a
          href={localePath(locale, "guides/legal-cannabis-tourists")}
          class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim"
        >
          {copy.legalGuideLabel}
        </a>
        <a href={localePath(locale, "locations")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {copy.locationsLabel}
        </a>
      </nav>
    </div>
  </article>
  <MapBlock locale={locale} />
  <Footer locale={locale} pathSuffix={`delivery/${area.slug}`} />
</PageLayout>
