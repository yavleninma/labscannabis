    faq: [
      {
        q: "{area} から来店前に相談できますか？",
        a: "はい。エリア、時間、希望する効果、受け取りか配送可能性確認かを送ってください。",
      },
      {
        q: "オンラインで配送は保証されますか？",
        a: "いいえ。配送可能性はエリア、時間、必要情報を確認した後に個別で相談します。",
      },
      {
        q: "直接来店できますか？",
        a: "はい。店舗は Walking Street から近い Soi Hollywood にあります。",
      },
    ],
  },
};
const copy = deliveryCopy[locale] ?? deliveryCopy.en;
const ui = t(locale);
const vars = { area: areaName, eta: details.etaMinutes };
const notes = getAreaNotes(area.slug, locale);
const title = renderCopy(copy.title, vars);
const description = renderCopy(copy.description, vars);
const h1 = renderCopy(copy.h1, vars);
const intro = renderCopy(copy.intro, vars);
const faq = copy.faq.map((item) => ({
  q: renderCopy(item.q, vars),
  a: renderCopy(item.a, vars),
}));
const breadcrumbs = [
  { name: ui.nav.home, pathSuffix: "" },
  { name: copy.kicker, pathSuffix: "locations" },
  { name: areaName, pathSuffix: `delivery/${area.slug}` },
];
const whatsappUrl = `${CONTACT.whatsappWithMsg(h1)}&source=delivery`;
---

<PageLayout
  locale={locale}
  pathSuffix={`delivery/${area.slug}`}
  title={title}
  description={description}
  faq={faq}
  pageType="delivery"
  breadcrumbs={breadcrumbs}
  serviceAreaName={areaName}
>
  <article class="px-4 pt-8 pb-6">
    <div class="mx-auto max-w-lg">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-dim">{copy.kicker}</p>
      <h1 class="mt-1 text-3xl font-bold leading-tight">{h1}</h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted">{intro}</p>
      {notes?.delivery && <p class="mt-3 text-base leading-relaxed text-text-muted">{notes.delivery}</p>}

      <div class="mt-6 grid grid-cols-2 gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-emerald px-4 py-3.5 text-center text-base font-bold text-black"
          data-track="contact_whatsapp_click"
          data-track-placement="delivery"
          data-track-detail={`delivery:${area.slug}:whatsapp`}
          data-wa-source="delivery"
          data-whatsapp-ref={`delivery:${area.slug}`}
        >
          {copy.cta}
        </a>
        <a
          href={getMapsSearchUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="card-surface px-4 py-3.5 text-center text-base font-semibold text-emerald-dim"
          data-track="map_open_click"
          data-track-placement="delivery_area"
          data-track-detail={`delivery:${area.slug}:maps`}
        >
          {copy.maps}
        </a>
      </div>

      <section class="mt-8">
        <h2 class="text-xl font-bold text-emerald-dim">{copy.statusTitle}</h2>
        <div class="mt-3 grid gap-3">
          {[renderCopy(copy.eta, vars), copy.stock, copy.privateTerms].map((item) => (
            <p class="card-surface px-4 py-3 text-base text-text-muted">{item}</p>
          ))}
        </div>
      </section>

      {details.landmarks.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-bold text-emerald-dim">{areaName}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {details.landmarks.map((landmark) => (
              <li class="rounded-full border border-border bg-bg-card px-3 py-1.5 text-sm text-text-muted">{landmark}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-8">
        <h2 class="mb-3 text-xl font-bold">{copy.faqTitle}</h2>
        {faq.map((item) => (
          <details class="card-surface mb-3 p-4">
            <summary class="cursor-pointer text-base font-semibold">{item.q}</summary>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.a}</p>
          </details>
        ))}
      </section>

      <nav class="mt-8 grid gap-3" aria-label={copy.relatedLabel}>
        <a href={localePath(locale, `areas/${area.slug}`)} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {renderCopy(copy.relatedArea, vars)}
        </a>
        <a href={localePath(locale, "locations")} class="card-surface px-4 py-3 text-base font-medium hover:text-emerald-dim">
          {ui.footerSeo.allPages}
        </a>
      </nav>
    </div>
  </article>
  <PriceLadder locale={locale} />
  <ReviewStrip locale={locale} />
  <MapBlock locale={locale} />
  <MedicalCardNote locale={locale} />
  <Footer locale={locale} pathSuffix={`delivery/${area.slug}`} />
</PageLayout>
