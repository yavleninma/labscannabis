---
import PageLayout from "@/layouts/PageLayout.astro";
import PriceLadder from "@/components/PriceLadder.astro";
import ReviewStrip from "@/components/ReviewStrip.astro";
import MapBlock from "@/components/MapBlock.astro";
import MedicalCardNote from "@/components/MedicalCardNote.astro";
import Footer from "@/components/Footer.astro";
import { LOCALES, localePath, type Locale } from "@/lib/i18n";
import { AREAS, getAreaBySlug } from "@/data/seo-matrix";
import { AREA_DETAILS, getAreaNotes, renderCopy } from "@/data/area-copy";
import { CONTACT, getMapsSearchUrl } from "@/data/site";
import { t } from "@/lib/ui";

export function getStaticPaths() {
  const paths: { params: { lang: string; area: string } }[] = [];
  for (const lang of LOCALES) {
    for (const area of AREAS) {
      paths.push({ params: { lang, area: area.slug } });
    }
  }
  return paths;
}

const { lang, area: areaSlug } = Astro.params;
const locale = lang as Locale;
const area = getAreaBySlug(areaSlug!)!;
const areaName = area.name[locale];
const details = AREA_DETAILS[area.slug] ?? { etaMinutes: 25, landmarks: [] };
const deliveryCopy: Record<
  Locale,
  {
    title: string;
    description: string;
    h1: string;
    intro: string;
    kicker: string;
    cta: string;
    maps: string;
    statusTitle: string;
    eta: string;
    stock: string;
    privateTerms: string;
    faqTitle: string;
    relatedLabel: string;
    relatedArea: string;
    faq: { q: string; a: string }[];
  }
> = {
  en: {
    title: "Cannabis delivery possibility for {area} | Labs Cannabis Pattaya",
    description:
