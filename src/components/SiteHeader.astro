---
import type { Locale } from "@/lib/i18n";
import { localePath } from "@/lib/i18n";
import { t } from "@/lib/ui";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import OpeningStatus from "@/components/OpeningStatus.astro";
import { CONTACT, getMapsDirectionsUrl } from "@/data/site";
import { CTA_LABELS, ctaWhatsAppHref } from "@/data/cta-copy";

/**
 * Шапка (W1-06).
 *
 * Была `hidden … sm:inline-flex` на WhatsApp и `hidden … md:flex` на навигации:
 * на мобильном — а это 80-90% трафика Паттайи — в шапке не оставалось ни одной
 * кнопки действия, только переключатель языка. Теперь три действия видны от
 * 320 px: написать, позвонить, дойти. Подписи сворачиваются в иконки, потому что
 * место в 320 px принадлежит действиям, а не тексту.
 */
interface Props {
  locale: Locale;
  pathSuffix?: string;
}

const { locale, pathSuffix = "" } = Astro.props;
const ui = t(locale);
const homeHref = localePath(locale);
const labels = CTA_LABELS[locale];
const whatsappHref = ctaWhatsAppHref(locale, "visit");
const directionsHref = getMapsDirectionsUrl();
const headerLabels: Record<Locale, { areas: string; visit: string; primary: string }> = {
  en: { areas: "Areas", visit: "Visit", primary: "Primary" },
  ru: { areas: "Районы", visit: "Локация", primary: "Главная навигация" },
  th: { areas: "พื้นที่", visit: "ที่ตั้ง", primary: "เมนูหลัก" },
  ar: { areas: "المناطق", visit: "الموقع", primary: "التنقل الرئيسي" },
  zh: { areas: "区域", visit: "位置", primary: "主导航" },
  ko: { areas: "지역", visit: "위치", primary: "기본 탐색" },
  ja: { areas: "エリア", visit: "場所", primary: "主要ナビゲーション" },
};
const nav = headerLabels[locale] ?? headerLabels.en;
const navItems = [
  { href: `${homeHref}#areas`, label: nav.areas, key: "areas" },
  { href: `${homeHref}#visit`, label: nav.visit, key: "visit" },
  // Страница с контактами достижима из шапки: до этого Telegram и LINE лежали
  // только на /contact/, а ссылка на неё была лишь в футере.
  { href: localePath(locale, "contact"), label: ui.nav.contact, key: "contact" },
];
const actionClass =
  "inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-card transition-colors hover:border-emerald/40";
---

<header data-boilerplate class="sticky top-0 z-[80] border-b border-border/80 bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-2 px-4 py-2.5">
    <a
      href={homeHref}
      class="min-w-0 truncate text-base font-extrabold text-text hover:text-emerald-dim"
      data-track="nav_click"
      data-placement="header"
      data-target="home"
    >
      <span class="sm:hidden">LABS</span>
      <span class="hidden sm:inline">{ui.brand}</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label={nav.primary}>
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-2 text-sm font-semibold text-text-muted transition-colors hover:bg-bg-elevated hover:text-emerald-dim"
          data-track="nav_click"
          data-placement="header"
          data-target={item.key}
        >
          {item.label}
        </a>
      ))}
    </nav>
    {/*
      Статус «открыто сейчас» — от lg, где в шапке уже есть свободное место:
      на 320 px оно принадлежит кнопкам действия. Пока часы не подтверждены
      (O-01), компонент не рендерит ничего и шапка выглядит как раньше.
    */}
    <OpeningStatus locale={locale} class="hidden text-sm text-text-muted lg:inline-flex" />
    <div class="flex shrink-0 items-center gap-1.5">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-emerald text-black transition-colors hover:bg-emerald/90 sm:w-auto sm:gap-2 sm:px-3.5"
        aria-label={`${ui.contact.whatsapp} — ${labels.whatsapp}`}
        title={labels.whatsapp}
        data-track="contact_click"
        data-channel="whatsapp"
        data-placement="header"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="hidden text-sm font-extrabold sm:inline">{ui.contact.whatsapp}</span>
      </a>
      <a
        href={CONTACT.tel}
        class={`${actionClass} text-text`}
        aria-label={`${ui.contact.call} ${CONTACT.phoneDisplay}`}
        title={CONTACT.phoneDisplay}
        data-track="contact_click"
        data-channel="phone"
        data-placement="header"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.56a1 1 0 01-.25 1.02l-2.2 2.21z"/>
        </svg>
      </a>
      <a
        href={directionsHref}
        target="_blank"
        rel="noopener noreferrer"
        class={`${actionClass} text-emerald-dim`}
        aria-label={labels.directions}
        title={labels.directions}
        data-track="contact_click"
        data-channel="directions"
        data-placement="header"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
          <path d="M21.71 11.29l-9-9a1 1 0 00-1.42 0l-9 9a1 1 0 000 1.42l9 9a1 1 0 001.42 0l9-9a1 1 0 000-1.42zM13 15v-2.5h-3V15H8v-3.5a1 1 0 011-1h4V8l3.5 3.5L13 15z"/>
        </svg>
      </a>
      <LanguageSwitcher locale={locale} pathSuffix={pathSuffix} compact />
    </div>
  </div>
</header>
