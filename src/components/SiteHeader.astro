---
import type { Locale } from "@/lib/i18n";
import { localePath } from "@/lib/i18n";
import { t } from "@/lib/ui";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  pathSuffix?: string;
}

const { locale, pathSuffix = "" } = Astro.props;
const ui = t(locale);
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-bg/95 backdrop-blur-sm">
  <div class="site-main flex items-center justify-between gap-3 py-3">
    <a
      href={localePath(locale)}
      class="truncate text-base font-bold text-text hover:text-emerald-dim"
      data-track="menu_link_click"
      data-track-placement="header"
      data-track-detail="header:home"
    >
      {ui.brand}
    </a>
    <LanguageSwitcher locale={locale} pathSuffix={pathSuffix} />
  </div>
</header>
