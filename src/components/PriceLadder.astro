---
import type { Locale } from "@/lib/i18n";
import { CONTACT } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const inquiryText =
  "Hi Labs Cannabis, I am 20+ and in Pattaya. I would like to ask about lawful medical cannabis eligibility and what documentation is needed before visiting.";
const inquiryHref = CONTACT.whatsappWithMsg(inquiryText);

const checkpoints = [
  {
    title: "Eligibility first",
    body: "Ask what Thai medical documentation is required before travelling to the shop.",
  },
  {
    title: "No online sale",
    body: "This website does not sell, reserve, deliver, or accept payment for cannabis flower.",
  },
  {
    title: "Visit planning",
    body: "Confirm directions to Pattaya 13 Alley (Soi Hollywood) and what to bring before you arrive.",
  },
];
---

<section id="inquiry" class="py-12">
  <div class="site-main">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-emerald-dim">Compliance inquiry</p>
    <h2 class="section-title">Ask before visiting</h2>
    <p class="section-lead">
      WhatsApp is for eligibility questions, documentation guidance, and directions only. No online order,
      reservation, delivery, or payment is completed through this website.
    </p>

    <div class="space-y-3">
      {checkpoints.map((item) => (
        <div class="card-surface p-5">
          <h3 class="text-lg font-bold text-text">{item.title}</h3>
          <p class="mt-1.5 text-base leading-relaxed text-text-muted">{item.body}</p>
        </div>
      ))}
    </div>

    <a
      href={inquiryHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-emerald px-4 py-3.5 text-base font-bold text-black"
      data-track="contact_whatsapp_click"
      data-track-placement="inquiry_panel"
      data-track-detail="inquiry_panel:whatsapp"
    >
      Request eligibility guidance
    </a>
  </div>
</section>
