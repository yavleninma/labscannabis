---
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<div id="age-gate" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/75 p-6 backdrop-blur-sm" role="dialog" aria-modal="true">
  <div class="card-surface max-w-sm p-8 text-center">
    <h2 class="mb-3 text-2xl font-bold">{ui.ageGate.title}</h2>
    <p class="mb-6 text-base leading-relaxed text-text-muted">{ui.ageGate.text}</p>
    <div class="flex flex-col gap-3">
      <button
        type="button"
        id="age-enter"
        class="rounded-full bg-emerald px-6 py-3.5 text-base font-bold text-black"
      >
        {ui.ageGate.enter}
      </button>
      <a href="https://www.google.com" class="text-base text-text-muted underline">
        {ui.ageGate.exit}
      </a>
    </div>
  </div>
</div>

<script>
  const KEY = "lc_age_ok";
  const gate = document.getElementById("age-gate");
  const enter = document.getElementById("age-enter");
  if (gate && !localStorage.getItem(KEY)) {
    gate.classList.remove("hidden");
    gate.classList.add("flex");
  }
  enter?.addEventListener("click", () => {
    localStorage.setItem(KEY, "1");
    gate?.classList.add("hidden");
    gate?.classList.remove("flex");
  });
</script>
