---
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";
import { formatRatingLine } from "@/lib/rating";
import { localePath } from "@/lib/i18n";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import OpeningStatus from "@/components/OpeningStatus.astro";
import { ADDRESS, BRAND, CONTACT, GOOGLE, getMapsSearchUrl } from "@/data/site";
import { getFooterServiceLinks } from "@/data/footer-seo-links";
import { renderCopy } from "@/data/area-copy";

interface Props {
  locale: Locale;
  pathSuffix?: string;
}

const { locale, pathSuffix = "" } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();
/**
 * Строка «на Google Maps как LABS DISPENSARY» была захардкожена по-английски и
 * уезжала в этом виде на все 210 страниц во всех 7 локалях. Перевод для этой же
 * мысли уже существовал (`index.astro`, ключ `listedAs`) — теперь он один на всех.
 */
const listedAs = renderCopy(ui.footer.listedAs, { brand: BRAND.name, listing: GOOGLE.listingName });
/**
 * Ключа `hours` здесь больше нет. В нём лежало «Check Google Maps before
 * visiting.» / «Перед визитом проверьте Google Maps.» — то есть сайт письменно
 * признавался, что не знает собственных часов, и отправлял человека выяснять
 * главный вопрос визита на чужой ресурс. Часы выводит `OpeningStatus`, когда их
 * подтвердит владелец (O-01), а место в футере занимает то, что подтверждено
 * прямо сейчас: рейтинг карточки и ссылка на отзывы.
 */
const footerCopy: Record<Locale, { visit: string; maps: string; legal: string }> = {
  en: {
    visit: "Visit",
    maps: "Open Google Maps",
    legal:
      "Cannabis flower is a controlled herb. The official tourist notice requires a valid prescription issued in Thailand and prohibits online sales and advertising. This site accepts no orders or payments; read the current legal guide.",
  },
  ru: {
    visit: "Локация",
    maps: "Открыть Google Maps",
    legal:
      "Соцветия каннабиса — контролируемая трава. Официальное уведомление требует от туристов действующий рецепт, выданный в Таиланде, и запрещает онлайн-продажи и рекламу. Сайт не принимает заказы или оплату; читайте актуальный правовой гид.",
  },
  th: {
    visit: "ที่ตั้ง",
    maps: "เปิด Google Maps",
    legal:
      "ช่อดอกกัญชาเป็นสมุนไพรควบคุม ประกาศสำหรับนักท่องเที่ยวกำหนดให้มีใบสั่งจ่ายยาที่ออกในไทยและห้ามขายออนไลน์หรือโฆษณา เว็บไซต์ไม่รับคำสั่งซื้อหรือชำระเงิน โปรดอ่านคู่มือกฎหมายปัจจุบัน",
  },
  ar: {
    visit: "الموقع",
    maps: "فتح Google Maps",
    legal:
      "زهور القنب عشبة خاضعة للرقابة. يشترط الإشعار الرسمي للسياح وصفة سارية صادرة في تايلاند ويحظر البيع الإلكتروني والإعلان. لا يقبل الموقع طلبات أو مدفوعات؛ اقرأ الدليل القانوني الحالي.",
  },
  zh: {
    visit: "位置",
    maps: "打开 Google Maps",
    legal:
      "大麻花属于受控草药。官方游客通知要求持有在泰国签发的有效处方，并禁止在线销售与广告。本网站不接受订单或付款；请阅读现行法律指南。",
  },
  ko: {
    visit: "위치",
    maps: "Google Maps 열기",
    legal:
      "대마 꽃은 관리 대상 약초입니다. 공식 관광객 공지는 태국에서 발급된 유효한 처방전을 요구하고 온라인 판매와 광고를 금지합니다. 이 사이트는 주문이나 결제를 받지 않으며 최신 법률 가이드를 확인하세요.",
  },
  ja: {
    visit: "場所",
    maps: "Google Mapsを開く",
    legal:
      "大麻の花は管理対象のハーブです。旅行者向け公式通知はタイ国内発行の有効な処方箋を求め、オンライン販売と広告を禁止しています。このサイトは注文や支払いを受け付けません。最新の法的ガイドをご確認ください。",
  },
};
const copy = footerCopy[locale] ?? footerCopy.en;
const addressLine = `${ADDRESS.street}, ${ADDRESS.locality}, ${ADDRESS.region} ${ADDRESS.postalCode}`;
/** Цифры карточки Google — визуально и со ссылкой на источник, без разметки рейтинга. */
const ratingLine = formatRatingLine(locale);
/**
 * Служебный минимум футера (T-07).
 *
 * Здесь стояли три тематические группы на пятнадцать слагов, и они уходили в
 * футер каждой страницы. Из-за этого у любой indexable-страницы было ровно одно
 * и то же число источников: вес размазывался ровным слоем, и структура сайта не
 * читалась ни человеком, ни краулером. Тематические связи переехали в
 * `RelatedLinks` (свой набор у каждого слага), а в футере остаётся то, что в
 * футере ищут: где мы, кто мы и что говорит закон.
 *
 * Эти ссылки НЕ размечены `data-seo-context-link`: они одинаковы на всех
 * страницах, и помечать boilerplate тематической связью — способ вернуть тот же
 * плоский граф под новым именем.
 */
const serviceLinks = getFooterServiceLinks(locale, pathSuffix);

---

<footer data-boilerplate class="border-t border-border bg-bg-elevated py-10 pb-28">
  <div class="site-main space-y-8 text-base text-text-muted">
    <nav class="flex flex-wrap gap-4 font-medium">
      <a href={localePath(locale)} class="hover:text-emerald-dim">{ui.nav.home}</a>
      <a
        href={`${localePath(locale)}#visit`}
        class="hover:text-emerald-dim"
        data-track="nav_click"
        data-placement="footer"
        data-target="visit"
      >
        {copy.visit}
      </a>
      <a
        href={localePath(locale, "contact")}
        class="hover:text-emerald-dim"
        data-track="nav_click"
        data-placement="footer"
        data-target="contact"
      >
        {ui.nav.contact}
      </a>
    </nav>

    {serviceLinks.length > 0 && (
      <nav aria-label={ui.footerSeo.moreTitle} class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {serviceLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-emerald-dim"
            data-track="nav_click"
            data-placement="footer"
            data-target={link.suffix}
          >
            {ui.footerSeo[link.labelKey]}
          </a>
        ))}
      </nav>
    )}

    <div class="rounded-xl border border-border bg-bg-card p-4 text-sm leading-relaxed">
      <p class="font-bold text-text">{listedAs}</p>
      <address class="mt-2 not-italic">{addressLine}</address>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
        <a href={CONTACT.tel} class="font-bold text-text hover:text-emerald-dim" data-track="contact_click" data-channel="phone" data-placement="footer">{CONTACT.phoneDisplay}</a>
        <a href={GOOGLE.listingUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-dim hover:underline" data-track="contact_click" data-channel="maps" data-placement="footer">{copy.maps}</a>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6">
      <LanguageSwitcher locale={locale} pathSuffix={pathSuffix} />
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <a
          href={getMapsSearchUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-emerald-dim hover:underline"
          data-track="contact_click"
          data-channel="maps"
          data-placement="footer"
        >
          {ratingLine}
        </a>
        <OpeningStatus locale={locale} class="inline-flex" />
      </div>
    </div>

    <p class="text-sm leading-relaxed">{copy.legal}</p>
    <p class="text-sm">&copy; {year} Labs Cannabis. {ui.footer.rights}</p>
  </div>
</footer>
