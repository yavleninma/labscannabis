---
import type { Locale } from "@/lib/i18n";
import { LOCALE_HREFLANG } from "@/lib/i18n";
import { RATING, getMapsSearchUrl } from "@/data/site";
import { renderCopy } from "@/data/area-copy";
import { pickDailyLocalizedReviews } from "@/lib/reviews";
import { t } from "@/lib/ui";

/**
 * Отзывы и рейтинг карточки Google (W1-12).
 *
 * До этого блок назывался «Проверьте актуальную карточку Google Maps» и не
 * содержал ни одной цифры: 4.8 и сотня отзывов — самый сильный аргумент
 * магазина — лежали в `src/data/site.ts` и не выводились нигде, а
 * `src/lib/reviews.ts` вместе с семью файлами переводов не импортировался ни
 * одной страницей. Здесь они и подключаются.
 *
 * Рейтинг показывается ТОЛЬКО визуально и ТОЛЬКО со ссылкой на источник:
 * `aggregateRating` в разметке `LocalBusiness` звёзд в выдаче не даёт (Google
 * не выводит review snippet для отзывов, которые контролирует сам объект), а
 * разметка `Review` с именами здесь была бы прямой ложью — тексты переводились
 * машинно, а имена в пуле выглядят реконструкцией. Отсюда же пометка о переводе
 * на каждой карточке и ссылка «читать все».
 *
 * `data-boilerplate` — блок одинаков на всех страницах локали и не должен
 * попадать в замер уникальности основного контента (W1-02).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
/**
 * Пока отзывы не выверены по источнику (`REVIEWS_VERIFIED === false` в
 * `src/data/reviews-pool.ts`), список пуст и блок показывает только рейтинг
 * карточки со ссылкой на неё: 4.8 и число отзывов — цифра Google, а не наше
 * утверждение об авторе. Именные цитаты включаются одним флагом.
 */
const reviews = pickDailyLocalizedReviews(locale, new Date(), 3);
const subtitle = renderCopy(ui.reviews.subtitle, { rating: RATING.value, count: RATING.count });
const readAll = renderCopy(ui.reviews.readAll, { count: RATING.count });
const listingUrl = getMapsSearchUrl();
const dateFormatter = new Intl.DateTimeFormat(LOCALE_HREFLANG[locale], {
  year: "numeric",
  month: "long",
});
---

<section data-boilerplate class="py-10">
  <div class="site-main">
    <h2 class="section-title">{ui.reviews.title}</h2>
    <p class="section-lead">
      <a
        href={listingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-emerald-dim hover:underline"
        data-track="contact_click"
        data-channel="maps"
        data-placement="reviews"
      >
        {subtitle}
      </a>
    </p>

    {reviews.length > 0 && (
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.map((review) => (
          <li class="card-surface flex flex-col p-5">
            <p class="text-sm font-bold text-emerald" aria-label={`${review.stars}/5`}>
              <span aria-hidden="true">{"★".repeat(review.stars)}</span>
            </p>
            <blockquote class="mt-3 flex-1 text-base leading-relaxed text-text">
              {review.displayText}
            </blockquote>
            <p class="mt-4 text-sm font-semibold text-text">{review.name}</p>
            <p class="mt-1 text-sm text-text-muted">{dateFormatter.format(new Date(review.date))}</p>
            {review.isTranslation && (
              <p class="mt-2 text-xs text-text-muted">
                {renderCopy(ui.reviews.translatedNote, {
                  lang: ui.reviews.sourceLang[review.originalLang],
                })}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}

    <a
      href={listingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex font-bold text-emerald-dim hover:underline"
      data-track="contact_click"
      data-channel="maps"
      data-placement="reviews"
    >
      {readAll}
    </a>
  </div>
</section>
