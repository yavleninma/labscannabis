---
import type { Locale } from "@/lib/i18n";
import { GOOGLE } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy: Record<
  Locale,
  {
    title: string;
    lead: string;
    listing: string;
    note: string;
    cta: string;
  }
> = {
  en: {
    title: "Check the current Google Maps listing",
    lead: "Open the public listing for the current pin, route, and listing details before visiting.",
    listing: "Labs Cannabis — listed on Google Maps as LABS DISPENSARY",
    note: "Public listing details can change. Check Google Maps before travelling.",
    cta: "Open Google Maps",
  },
  ru: {
    title: "Проверьте актуальную карточку Google Maps",
    lead: "Перед визитом откройте публичную карточку с актуальным пином, маршрутом и данными.",
    listing: "Labs Cannabis — в Google Maps указан как LABS DISPENSARY",
    note: "Данные публичной карточки могут меняться. Перед поездкой проверьте Google Maps.",
    cta: "Открыть Google Maps",
  },
  th: {
    title: "ตรวจสอบข้อมูลล่าสุดใน Google Maps",
    lead: "ก่อนเดินทาง โปรดเปิดข้อมูลสาธารณะเพื่อดูหมุด เส้นทาง และรายละเอียดล่าสุด",
    listing: "Labs Cannabis — แสดงใน Google Maps ในชื่อ LABS DISPENSARY",
    note: "รายละเอียดสาธารณะอาจเปลี่ยนแปลง โปรดตรวจสอบ Google Maps ก่อนเดินทาง",
    cta: "เปิด Google Maps",
  },
  ar: {
    title: "تحقق من بطاقة Google Maps الحالية",
    lead: "افتح البطاقة العامة قبل الزيارة لمعرفة الدبوس والمسار والتفاصيل الحالية.",
    listing: "Labs Cannabis — مدرج على Google Maps باسم LABS DISPENSARY",
    note: "قد تتغير تفاصيل البطاقة العامة. تحقق من Google Maps قبل التوجه.",
    cta: "فتح Google Maps",
  },
  zh: {
    title: "查看当前 Google Maps 商家信息",
    lead: "出发前请打开公开商家信息，查看当前定位、路线和详情。",
    listing: "Labs Cannabis — 在 Google Maps 上显示为 LABS DISPENSARY",
    note: "公开商家信息可能变化。出发前请查看 Google Maps。",
    cta: "打开 Google Maps",
  },
  ko: {
    title: "현재 Google Maps 업체 정보 확인",
    lead: "방문 전에 공개 업체 정보에서 현재 핀, 경로와 세부 정보를 확인하세요.",
    listing: "Labs Cannabis — Google Maps에는 LABS DISPENSARY로 표시",
    note: "공개 업체 정보는 바뀔 수 있습니다. 출발 전에 Google Maps를 확인하세요.",
    cta: "Google Maps 열기",
  },
  ja: {
    title: "現在のGoogle Maps情報を確認",
    lead: "来店前に公開情報を開き、現在のピン、経路、詳細をご確認ください。",
    listing: "Labs Cannabis — Google MapsではLABS DISPENSARYと表示",
    note: "公開情報は変更される場合があります。出発前にGoogle Mapsをご確認ください。",
    cta: "Google Mapsを開く",
  },
};
const text = copy[locale] ?? copy.en;
---

<section class="py-10">
  <div class="site-main">
    <h2 class="section-title">{text.title}</h2>
    <p class="section-lead">{text.lead}</p>
    <div class="card-surface p-5">
      <p class="text-base font-semibold text-text">{text.listing}</p>
      <p class="mt-2 text-base leading-relaxed text-text-muted">{text.note}</p>
      <a
        href={GOOGLE.listingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex rounded-xl bg-emerald px-4 py-3 text-base font-bold text-black"
        data-track="map_open_click"
        data-track-placement="listing_verification"
        data-track-detail="listing_verification:google_maps"
      >
        {text.cta}
      </a>
    </div>
  </div>
</section>
