---
import type { Locale } from "@/lib/i18n";
import { GOOGLE } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="py-10">
  <div class="site-main">
    <h2 class="section-title">Verify the listing</h2>
    <p class="section-lead">
      Use the Google Business Profile for the latest public listing details, directions, and review
      context before visiting.
    </p>
    <div class="card-surface p-5">
      <p class="text-base font-semibold text-text">Labs Cannabis on Google Maps</p>
      <p class="mt-2 text-base leading-relaxed text-text-muted">
        Review counts, hours, and listing details can change. Google Maps is the source of truth for
        public listing signals.
      </p>
      <a
        href={GOOGLE.listingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex rounded-xl bg-emerald px-4 py-3 text-base font-bold text-black"
        data-track="review_listing_click"
        data-track-placement="review_strip"
        data-track-detail="review_strip:google_listing"
      >
        Open Google listing
      </a>
    </div>
  </div>
</section>
