---
import {
  CONTACT_CHANNELS,
  CONTACT_EVENT,
  NAV_EVENT,
  TRACK_FALLBACK,
  TRACK_PLACEMENTS,
  getYandexMetrikaId,
} from "@/lib/analytics";

/**
 * Единственный слушатель кликов на сайте (W1-08).
 *
 * Что здесь было и почему исчезло:
 * - `window.va?.("event", name, payload)` — нарушенный контракт Vercel
 *   Analytics, который ожидает `va('event', { name, data })`. События не
 *   писались вообще, то есть конверсия была неизмерима;
 * - `window.dataLayer.push(...)` и `window.gtag?.(...)` — вызовы в пустоту: ни
 *   GTM, ни GA4 на сайте не подключены;
 * - `payload` из 8–14 ключей — Vercel хранит максимум два ключа данных на
 *   событие, остальное молча отбрасывается;
 * - эвристика `getWhatsAppSource` / `readCtaUtm` — угадывание источника по
 *   пути, рефереру и восьми `data-*` синонимам. Не нужна: канал и место теперь
 *   проставлены на якоре явно;
 * - атрибуция в `sessionStorage` — её единственным потребителем был тот же
 *   payload; источник визита Метрика и Vercel считают сами, дублировать нечем.
 *
 * Слушатель ровно один и делегированный: на клик уходит ровно одно событие,
 * без дублей от вложенных обработчиков.
 */
const ymId = getYandexMetrikaId();
---

<script
  define:vars={{
    contactEvent: CONTACT_EVENT,
    navEvent: NAV_EVENT,
    knownChannels: CONTACT_CHANNELS,
    knownPlacements: TRACK_PLACEMENTS,
    fallback: TRACK_FALLBACK,
    ymId,
  }}
>
  (() => {
    const channels = new Set(knownChannels);
    const placements = new Set(knownPlacements);

    /** Неизвестное значение не выдумывается, а сваливается в один «other». */
    const normalize = (value, allowed) => (allowed.has(value) ? value : fallback);

    document.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a[data-track]") : null;
      if (!(link instanceof HTMLAnchorElement)) return;

      const name = link.dataset.track;
      if (name !== contactEvent && name !== navEvent) return;

      const placement = normalize(link.dataset.placement, placements);
      const data =
        name === contactEvent
          ? { channel: normalize(link.dataset.channel, channels), placement }
          : { target: String(link.dataset.target || "link").slice(0, 64), placement };

      // Vercel Web Analytics: строго `{ name, data }` и не больше двух ключей.
      window.va?.("event", { name, data });

      // Метрика: цель на канал. Переходы внутри сайта целью не считаются —
      // конверсия у владельца одна, и это уход в контакт.
      if (ymId && name === contactEvent) {
        window.ym?.(ymId, "reachGoal", `contact_${data.channel}`);
      }
    });
  })();
</script>
