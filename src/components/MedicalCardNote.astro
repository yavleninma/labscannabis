---
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<section class="px-4 py-8">
  <div class="card-surface mx-auto max-w-lg p-5">
    <span class="mb-2 inline-block rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-text-muted">
      {ui.medical.badge}
    </span>
    <p class="text-base leading-relaxed text-text-muted">{ui.medical.text}</p>
  </div>
</section>
