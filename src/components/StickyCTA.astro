---
import type { Locale } from "@/lib/i18n";
import { CONTACT } from "@/data/site";
import { t } from "@/lib/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const labels: Record<Locale, string> = {
  en: "Ask menu on WhatsApp",
  ru: "Меню в WhatsApp",
  th: "ถามเมนูใน WhatsApp",
  ar: "اسأل عن القائمة في WhatsApp",
  zh: "WhatsApp 问菜单",
  ko: "WhatsApp 메뉴 문의",
  ja: "WhatsAppでメニュー確認",
};
const label = labels[locale] ?? labels.en;
const source = "sticky_cta";
const inquiryHref = CONTACT.whatsappWithMsg(
  "Hi Labs Cannabis, I am 20+ and in Pattaya. Please send today's cannabis menu, effects, freshness, location, and pickup/delivery options.",
);
const sourcedHref = `${inquiryHref}&source=${encodeURIComponent(source)}`;
---

<a
  id="sticky-wa-cta"
  href={sourcedHref}
  target="_blank"
  rel="noopener noreferrer"
  class="sticky-cta-shadow fixed bottom-4 start-4 end-4 z-50 flex min-h-14 translate-y-3 items-center justify-center gap-2 rounded-full bg-emerald px-5 py-3 text-base font-extrabold text-black opacity-0 pointer-events-none transition-all duration-300 ease-out data-[visible]:translate-y-0 data-[visible]:opacity-100 data-[visible]:pointer-events-auto sm:start-auto sm:bottom-5 sm:w-auto"
  aria-label={`${label} - ${ui.contact.whatsapp}`}
  aria-hidden="true"
  data-track="contact_whatsapp_click"
  data-track-placement={source}
  data-track-detail="sticky_cta:whatsapp"
  data-wa-source={source}
  data-whatsapp-ref="sticky_menu"
  data-utm-campaign={source}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span>{label}</span>
</a>

<script>
  const cta = document.getElementById("sticky-wa-cta");
  if (cta) {
    const setVisible = (visible: boolean) => {
      if (visible) {
        cta.setAttribute("data-visible", "");
        cta.setAttribute("aria-hidden", "false");
      } else {
        cta.removeAttribute("data-visible");
        cta.setAttribute("aria-hidden", "true");
      }
    };

    const hero = document.getElementById("home-hero") || document.getElementById("reels-hero");

    if (hero) {
      const observer = new IntersectionObserver(
        ([entry]) => setVisible(!entry.isIntersecting),
        { threshold: 0.2 },
      );
      observer.observe(hero);
    } else {
      const onScroll = () => setVisible(window.scrollY > 80);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }
  }
</script>
