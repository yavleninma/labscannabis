---
import type { Locale } from "@/lib/i18n";
import type { TrackPlacement } from "@/lib/analytics";
import { getRelatedLinks } from "@/data/footer-seo-links";
import { t } from "@/lib/ui";

/**
 * Контекстные ссылки между смысловыми соседями (W1-16).
 *
 * Футер даёт входящую ссылку всем страницам одинаково — это ноль сигнала о том,
 * какая страница какой ближе. Здесь ссылки выбираются от текущего слага:
 * с «купить» человек идёт в «от чего зависит цена» и в правила, с района — в
 * доставку, с гайда — в карточку магазина.
 *
 * Якоря помечены `data-seo-context-link`: без атрибута `scripts/check-seo.mjs`
 * их не видит, а проверка `REQUIRED_CONTEXTUAL_INLINKS` требует, чтобы у каждой
 * возвращённой в индекс страницы была входящая ссылка на её собственной локали.
 *
 * `data-boilerplate` здесь НЕ ставится: набор ссылок у каждой страницы свой, и
 * замер уникальности основного контента (W1-02) должен его видеть.
 */
interface Props {
  locale: Locale;
  /** Слаг текущей страницы: он же ключ соседей и он же исключается из выдачи. */
  pathSuffix?: string;
  /** Уезжает в аналитику как `data-placement` (W1-08). */
  placement: TrackPlacement;
  /** Сколько ссылок показать; на главной поднимается, чтобы покрыть весь набор. */
  limit?: number;
  /** Заголовок блока, если у страницы есть свой; по умолчанию — общий. */
  title?: string;
  /** Подводка под заголовком — необязательна. */
  lead?: string;
}

const { locale, pathSuffix = "", placement, limit = 3, title, lead } = Astro.props;
const ui = t(locale);
const links = getRelatedLinks(locale, pathSuffix, limit);
const headingId = `related-links-${placement}`;
---

{links.length > 0 && (
  <section class="px-4 py-10" aria-labelledby={headingId}>
    <div class="mx-auto max-w-5xl">
      <h2 id={headingId} class="text-2xl font-bold">{title ?? ui.footerSeo.relatedTitle}</h2>
      {lead && <p class="mt-3 max-w-2xl leading-relaxed text-text-muted">{lead}</p>}
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="card-surface flex h-full items-center p-4 text-base font-semibold text-emerald-dim hover:border-emerald-dim"
              data-track="nav_click"
              data-placement={placement}
              data-target={link.suffix}
              data-seo-context-link
            >
              {ui.footerSeo[link.labelKey]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
