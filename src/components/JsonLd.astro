---
import type { Locale } from "@/lib/i18n";
import { BRAND, ADDRESS, CONTACT, GOOGLE, HOURS } from "@/data/site";
import { AREAS } from "@/data/seo-matrix";
import { PRICE_LADDER } from "@/data/prices";
import { getSiteUrl, localePath, LOCALE_HREFLANG } from "@/lib/i18n";
import { getCanonical } from "@/lib/seo";

interface FaqItem {
  q: string;
  a: string;
}

type PageType = "home" | "seo" | "area" | "delivery" | "guide" | "strain" | "contact" | "wholesale" | "locations";

interface BreadcrumbItem {
  name: string;
  pathSuffix?: string;
  href?: string;
}

interface ArticleData {
  headline?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
}

interface Props {
  locale: Locale;
  pathSuffix?: string;
  title?: string;
  description?: string;
  faq?: FaqItem[];
  pageType?: PageType;
  breadcrumbs?: BreadcrumbItem[];
  serviceAreaName?: string;
  article?: ArticleData;
}

const {
  locale,
  pathSuffix = "",
  title = BRAND.name,
  description = "",
  faq = [],
  pageType = "seo",
  breadcrumbs = [],
  serviceAreaName,
  article,
} = Astro.props;
const baseUrl = getSiteUrl();
const pageUrl = getCanonical(locale, pathSuffix);
const businessId = `${baseUrl}/#business`;
const listedMin = PRICE_LADDER[0]?.total ?? 300;
const listedMax = PRICE_LADDER[PRICE_LADDER.length - 1]?.total ?? 40000;
const areaNames = [...new Set(AREAS.map((area) => area.name.en))];

const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Store"],
  "@id": businessId,
  name: BRAND.name,
  alternateName: BRAND.formerName,
  url: `${baseUrl}${localePath(locale)}`,
  telephone: CONTACT.phoneIntl,
  image: `${baseUrl}/media/IMG_20260517_175646.jpg`,
  sameAs: [GOOGLE.listingUrl],
  priceRange: `฿${listedMin}-฿${listedMax}`,
  hasMap: GOOGLE.listingUrl,
  address: {
    "@type": "PostalAddress",
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.locality,
    addressRegion: ADDRESS.region,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: ADDRESS.lat,
    longitude: ADDRESS.lng,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: HOURS.open,
    closes: HOURS.close,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: String(GOOGLE.rating),
    reviewCount: String(GOOGLE.reviewCount),
    bestRating: "5",
    worstRating: "1",
  },
  areaServed: areaNames.map((name) => ({
    "@type": "Place",
    name,
  })),
};

const breadcrumbItems =
  breadcrumbs.length > 0
    ? breadcrumbs
    : pathSuffix
      ? [
          { name: BRAND.name, pathSuffix: "" },
          { name: title, pathSuffix },
        ]
      : [];

const getBreadcrumbUrl = (item: BreadcrumbItem) => {
  if (item.href?.startsWith("https://") || item.href?.startsWith("http://")) return item.href;
  if (item.href?.startsWith("/")) return `${baseUrl}${item.href}`;
  return `${baseUrl}${localePath(locale, item.pathSuffix ?? "")}`;
};

const breadcrumbLd =
  breadcrumbItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: getBreadcrumbUrl(item),
        })),
      }
    : null;

const serviceLd =
  pageType === "area" || pageType === "delivery"
    ? {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        name:
          pageType === "delivery"
            ? `Cannabis delivery inquiry - ${serviceAreaName ?? "Pattaya"}`
            : `Cannabis shop near ${serviceAreaName ?? "Pattaya"}`,
        serviceType:
          pageType === "delivery"
            ? "WhatsApp inquiry for pickup or delivery possibility"
            : "Walk-in cannabis shop visit and WhatsApp menu inquiry",
        provider: { "@id": businessId },
        areaServed: {
          "@type": "Place",
          name: serviceAreaName ?? "Pattaya",
        },
        url: pageUrl,
      }
    : null;

const articleLd =
  pageType === "guide"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${pageUrl}#article`,
        headline: article?.headline ?? title,
        description,
        inLanguage: LOCALE_HREFLANG[locale],
        mainEntityOfPage: pageUrl,
        author: {
          "@type": "Organization",
          name: article?.author ?? BRAND.name,
        },
        publisher: {
          "@type": "Organization",
          name: BRAND.name,
          url: baseUrl,
        },
        datePublished: article?.datePublished ?? "2026-05-24",
        dateModified: article?.dateModified ?? "2026-08-13",
      }
    : null;

const faqLd =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const safeJson = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");

const jsonBlocks = [localBusiness, breadcrumbLd, serviceLd, articleLd, faqLd].filter(Boolean);
---

{jsonBlocks.map((block) => (
  <script type="application/ld+json" set:html={safeJson(block)} />
))}
