---
import type { Locale } from "@/lib/i18n";
import { BRAND, ADDRESS, CONTACT, GOOGLE, HOURS } from "@/data/site";
import { PRICE_LADDER } from "@/data/prices";
import { getSiteUrl, localePath, LOCALE_HREFLANG } from "@/lib/i18n";
import { getCanonical } from "@/lib/seo";
import { pickDailyLocalizedReviews } from "@/lib/reviews";

interface FaqItem {
  q: string;
  a: string;
}

type PageType = "home" | "seo" | "area" | "delivery" | "guide" | "strain" | "contact" | "wholesale" | "locations";

interface BreadcrumbItem {
  name: string;
  pathSuffix?: string;
  href?: string;
}

interface ArticleData {
  headline?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
}

interface Props {
  locale: Locale;
  pathSuffix?: string;
  title?: string;
  description?: string;
  faq?: FaqItem[];
  pageType?: PageType;
  breadcrumbs?: BreadcrumbItem[];
  serviceAreaName?: string;
  article?: ArticleData;
  includeOfferCatalog?: boolean;
}

const {
  locale,
  pathSuffix = "",
  title = BRAND.name,
  description = "",
  faq = [],
  pageType = "seo",
  breadcrumbs = [],
  serviceAreaName,
  article,
  includeOfferCatalog,
} = Astro.props;
const baseUrl = getSiteUrl();
const pageUrl = getCanonical(locale, pathSuffix);
const reviews = pickDailyLocalizedReviews(locale, new Date(), 3);
const businessId = `${baseUrl}/#business`;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Store"],
  "@id": businessId,
  name: BRAND.name,
  alternateName: BRAND.formerName,
  url: `${baseUrl}${localePath(locale)}`,
  telephone: CONTACT.phoneIntl,
  image: `${baseUrl}/media/IMG_20260517_175646.jpg`,
  sameAs: [GOOGLE.listingUrl],
  address: {
    "@type": "PostalAddress",
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.locality,
    addressRegion: ADDRESS.region,
    postalCode: ADDRESS.postalCode,
    addressCountry: ADDRESS.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: ADDRESS.lat,
    longitude: ADDRESS.lng,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: HOURS.open,
    closes: HOURS.close,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: String(GOOGLE.rating),
    reviewCount: String(GOOGLE.reviewCount),
    bestRating: "5",
  },
  priceRange: "\u0e3f",
  currenciesAccepted: "THB",
  paymentAccepted: "Cash, QR Bank Transfer",
  review: reviews.map((r) => ({
    "@type": "Review",
    author: { "@type": "Person", name: r.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
    reviewBody: r.displayText,
    datePublished: r.date,
  })),
};

const shouldIncludeOfferCatalog =
  includeOfferCatalog ?? ["home", "seo", "strain", "wholesale"].includes(pageType);

const offerCatalog = shouldIncludeOfferCatalog
  ? {
      "@context": "https://schema.org",
      "@type": "OfferCatalog",
      "@id": `${baseUrl}${localePath(locale)}#offer-catalog`,
      name: `${BRAND.name} cannabis weight menu`,
      url: `${baseUrl}${localePath(locale)}#prices`,
      itemListElement: PRICE_LADDER.map((tier) => ({
        "@type": "Offer",
        name: `${tier.weight} White Widow`,
        price: tier.total,
        priceCurrency: "THB",
        availability: "https://schema.org/InStock",
        url: `${baseUrl}${localePath(locale)}#prices`,
        itemOffered: {
          "@type": "Product",
          name: `White Widow Cannabis - ${tier.weight}`,
          brand: { "@type": "Brand", name: BRAND.name },
        },
      })),
    }
  : null;

const breadcrumbItems =
  breadcrumbs.length > 0
    ? breadcrumbs
    : pathSuffix
      ? [
          { name: BRAND.name, pathSuffix: "" },
          { name: title, pathSuffix },
        ]
      : [];

const getBreadcrumbUrl = (item: BreadcrumbItem) => {
  if (item.href?.startsWith("https://") || item.href?.startsWith("http://")) return item.href;
  if (item.href?.startsWith("/")) return `${baseUrl}${item.href}`;
  return `${baseUrl}${localePath(locale, item.pathSuffix ?? "")}`;
};

const breadcrumbLd =
  breadcrumbItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: getBreadcrumbUrl(item),
        })),
      }
    : null;

const serviceLd =
  pageType === "area" || pageType === "delivery"
    ? {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        name:
          pageType === "delivery"
            ? `Cannabis pickup and delivery coordination - ${serviceAreaName ?? "Pattaya"}`
            : `Cannabis retail service - ${serviceAreaName ?? "Pattaya"}`,
        serviceType: "Cannabis retail consultation and pickup coordination",
        provider: { "@id": businessId },
        areaServed: {
          "@type": "Place",
          name: serviceAreaName ?? "Pattaya",
        },
        url: pageUrl,
      }
    : null;

const articleLd =
  pageType === "guide"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${pageUrl}#article`,
        headline: article?.headline ?? title,
        description,
        inLanguage: LOCALE_HREFLANG[locale],
        mainEntityOfPage: pageUrl,
        author: {
          "@type": "Organization",
          name: article?.author ?? BRAND.name,
        },
        publisher: {
          "@type": "Organization",
          name: BRAND.name,
          url: baseUrl,
        },
        datePublished: article?.datePublished ?? "2026-05-24",
        dateModified: article?.dateModified ?? "2026-05-24",
      }
    : null;

const faqLd =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const safeJson = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");

const jsonBlocks = [
  localBusiness,
  offerCatalog,
  breadcrumbLd,
  serviceLd,
  articleLd,
  faqLd,
].filter(Boolean);
---

{jsonBlocks.map((block) => (
  <script type="application/ld+json" set:html={safeJson(block)} />
))}
