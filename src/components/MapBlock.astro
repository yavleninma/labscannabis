---
import type { Locale } from "@/lib/i18n";
import { getMapsEmbedUrl, getMapsSearchUrl } from "@/data/site";
import { t } from "@/lib/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<section id="location" class="py-12">
  <div class="site-main">
    <h2 class="section-title">{ui.location.title}</h2>
    <div class="card-surface overflow-hidden">
      <div class="aspect-video">
        <iframe
          src={getMapsEmbedUrl()}
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Labs Cannabis location"
        />
      </div>
      <a
        href={getMapsSearchUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 border-t border-border bg-bg-elevated px-4 py-3.5 text-base font-semibold text-emerald-dim transition-colors hover:bg-emerald/10"
      >
        {ui.location.openMaps}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
