{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "labscannabis.com" }], "destination": "https://labscannabis.boutique/:path*", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/", "destination": "/en/", "permanent": true },
    { "source": "/catalog", "destination": "/en/locations/", "permanent": true },
    { "source": "/catalog/", "destination": "/en/locations/", "permanent": true },
    { "source": "/menu", "destination": "/en/locations/", "permanent": true },
    { "source": "/menu/", "destination": "/en/locations/", "permanent": true },
    { "source": "/reels", "destination": "/en/", "permanent": true },
    { "source": "/reels/", "destination": "/en/", "permanent": true },
    { "source": "/price", "destination": "/en/", "permanent": true },
    { "source": "/price/", "destination": "/en/", "permanent": true },
    { "source": "/prices", "destination": "/en/", "permanent": true },
    { "source": "/prices/", "destination": "/en/", "permanent": true },
    { "source": "/whatsapp", "destination": "/en/contact/", "permanent": true },
    { "source": "/whatsapp/", "destination": "/en/contact/", "permanent": true },
    { "source": "/strain", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/strain/", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/strains", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/strains/", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/:lang/catalog", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/catalog/", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/menu", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/menu/", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/reels", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/reels/", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/price", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/price/", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/prices", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/prices/", "destination": "/:lang/", "permanent": true },
    { "source": "/:lang/whatsapp", "destination": "/:lang/contact/", "permanent": true },
    { "source": "/:lang/whatsapp/", "destination": "/:lang/contact/", "permanent": true },
    { "source": "/strains/types/:type", "destination": "/en/locations/", "permanent": true },
    { "source": "/strains/types/:type/", "destination": "/en/locations/", "permanent": true },
    { "source": "/strains/effects/:effect", "destination": "/en/locations/", "permanent": true },
    { "source": "/strains/effects/:effect/", "destination": "/en/locations/", "permanent": true },
    { "source": "/:lang/strains/types/:type", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/strains/types/:type/", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/strains/effects/:effect", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/:lang/strains/effects/:effect/", "destination": "/:lang/locations/", "permanent": true },
    { "source": "/strains/:slug", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/strains/:slug/", "destination": "/en/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/vice-city", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/vice-city/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/london-marker", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/london-marker/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/maui-wowie", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/maui-wowie/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/devil-cherries", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/devil-cherries/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/pink-runtz", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/pink-runtz/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/white-truffle", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/:lang/strains/white-truffle/", "destination": "/:lang/strains/white-widow/", "permanent": true },
    { "source": "/delivery/:area", "destination": "/en/delivery/:area/", "permanent": true },
    { "source": "/guides/:slug", "destination": "/en/guides/:slug/", "permanent": true },
    { "source": "/wholesale", "destination": "/en/wholesale/", "permanent": true },
    { "source": "/contact", "destination": "/en/contact/", "permanent": true }
  ]
}
