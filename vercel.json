{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "labscannabis.com" }], "destination": "https://labscannabis.boutique/:path*", "permanent": true },
    { "source": "/strains/:slug*", "destination": "/en/strains/:slug*", "permanent": false },
    { "source": "/wholesale", "destination": "/en/wholesale", "permanent": false },
    { "source": "/contact", "destination": "/en/contact", "permanent": false }
  ]
}
