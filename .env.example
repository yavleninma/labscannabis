PUBLIC_SITE_URL=https://labscannabis.boutique

# Яндекс.Метрика (W1-08). Пусто или не задано — счётчик не рендерится вообще.
# Только номер счётчика, например 98765432. Вебвизор и запись сессий выключены
# в src/components/Analytics.astro и включать их нельзя (PDPA).
PUBLIC_YM_ID=
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Sanity Studio access
# Set to "true" only when you need /studio. Keep disabled in production by default.
STUDIO_ENABLED=false

# Optional defense-in-depth if basic auth is added later.
# STUDIO_BASIC_AUTH_USER=
# STUDIO_BASIC_AUTH_PASSWORD=
